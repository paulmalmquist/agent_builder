generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AgentStatus {
  DRAFT      @map("draft")
  GENERATING @map("generating")
  READY      @map("ready")
  SHADOW     @map("shadow")
  CERTIFYING @map("certifying")
  CERTIFIED  @map("certified")
  REJECTED   @map("rejected")
  ACTIVE     @map("active")
  FAILED     @map("failed")
  RETIRED    @map("retired")
}

enum AgentDerivationMode {
  NEW       @map("new")
  CONFIGURE @map("configure")
  EXTEND    @map("extend")
}

enum CertificationHealth {
  NOT_CERTIFIED @map("not_certified")
  CURRENT       @map("current")
  DEGRADED      @map("degraded")
}

enum RetirementReason {
  EXPLICIT                @map("explicit")
  SUPERSEDED_BY_PROMOTION @map("superseded_by_promotion")
}

enum CertificationRunState {
  QUEUED  @map("queued")
  RUNNING @map("running")
  PASSED  @map("passed")
  FAILED  @map("failed")
  ERROR   @map("error")
}

enum CertificationRunKind {
  CHALLENGER               @map("challenger")
  CHAMPION_RECERTIFICATION @map("champion_recertification")
}

enum CertificationVerdict {
  PASSED @map("passed")
  FAILED @map("failed")
  ERROR  @map("error")
}

enum CertificationGateConfigState {
  ACTIVE     @map("active")
  SUPERSEDED @map("superseded")
}

enum CertificationGateKey {
  FACTUAL_ACCURACY     @map("factual_accuracy")
  CITATION_COVERAGE    @map("citation_coverage")
  UNAUTHORIZED_ACTIONS @map("unauthorized_actions")
  CHAMPION_REGRESSION  @map("champion_regression")
}

enum CertificationGateOperator {
  GTE @map("gte")
  LTE @map("lte")
  EQ  @map("eq")
}

enum CertificationGateResultStatus {
  PASSED         @map("passed")
  FAILED         @map("failed")
  NOT_APPLICABLE @map("not_applicable")
}

enum ExecutorKind {
  MANIFEST_FIXTURE @map("manifest_fixture")
}

enum EvaluationMode {
  CORPUS_COVERAGE    @map("corpus_coverage")
  SEMANTIC_EXECUTION @map("semantic_execution")
}

enum CertificationResultsAvailability {
  FULL               @map("full")
  SUMMARY_ONLY       @map("summary_only")
  PROMOTION_EVIDENCE @map("promotion_evidence")
}

enum EvalCaseTag {
  GOLDEN      @map("golden")
  REPLAY      @map("replay")
  FALSE_ALARM @map("false_alarm")
  REGRESSION  @map("regression")
}

enum EvalCaseSource {
  SEED     @map("seed")
  OVERRIDE @map("override")
  INCIDENT @map("incident")
}

enum PromotionDecisionType {
  PROMOTED @map("promoted")
  DECLINED @map("declined")
}

enum SpecSection {
  OUTCOMES   @map("outcomes")
  KNOWLEDGE  @map("knowledge")
  GUARDRAILS @map("guardrails")
  OUTPUTS    @map("outputs")
}

enum SectionConfirmationKind {
  GUIDED      @map("guided")
  INTERPRETED @map("interpreted")
  INHERITED   @map("inherited")
}

enum SpecStatus {
  DRAFT      @map("draft")
  READY      @map("ready")
  GENERATING @map("generating")
  GENERATED  @map("generated")
}

enum GenerationJobState {
  QUEUED    @map("queued")
  RUNNING   @map("running")
  SUCCEEDED @map("succeeded")
  FAILED    @map("failed")
}

enum SourceRole {
  KNOWLEDGE  @map("knowledge")
  SIGNAL     @map("signal")
  TELEMETRY  @map("telemetry")
  EVALUATION @map("evaluation")
}

enum SourceProvider {
  BIGQUERY   @map("bigquery")
  CONFLUENCE @map("confluence")
  JIRA       @map("jira")
  EMAIL      @map("email")
  SLACK      @map("slack")
  TELEMETRY  @map("telemetry")
  FIXTURE    @map("fixture")
}

enum SourceAuthority {
  SYSTEM_OF_RECORD @map("system_of_record")
  CURATED          @map("curated")
  DERIVED          @map("derived")
  TRANSIENT        @map("transient")
  UNTRUSTED        @map("untrusted")
}

enum GuardrailType {
  PROHIBITED_ACTION    @map("prohibited_action")
  APPROVAL_REQUIREMENT @map("approval_requirement")
  FAIL_CLOSED          @map("fail_closed")
  RESPONSE_REQUIREMENT @map("response_requirement")
}

enum EvaluationStatus {
  NOT_RUN @map("not_run")
  PASSED  @map("passed")
  FAILED  @map("failed")
}

enum ResourceKind {
  CORE_POLICY           @map("CorePolicy")
  CONTEXT_POLICY        @map("ContextPolicy")
  SKILL                 @map("Skill")
  PROJECT               @map("Project")
  AUTOMATION            @map("Automation")
  REFERENCE             @map("Reference")
  BUSINESS_DOMAIN       @map("BusinessDomain")
  PROTOCOL              @map("Protocol")
  KNOWLEDGE_SOURCE      @map("KnowledgeSource")
  EVALUATION_SUITE      @map("EvaluationSuite")
  METRIC_DEFINITION     @map("MetricDefinition")
  IMPROVEMENT_CANDIDATE @map("ImprovementCandidate")
  AGENT                 @map("Agent")
}

enum ResourceLifecycle {
  EXPERIMENTAL @map("experimental")
  CANDIDATE    @map("candidate")
  EVALUATING   @map("evaluating")
  EVALUATED    @map("evaluated")
  CERTIFIED    @map("certified")
  PRODUCTION   @map("production")
  DEPRECATED   @map("deprecated")
}

enum AuthorityGrantState {
  ACTIVE    @map("active")
  REVOKED   @map("revoked")
  EXHAUSTED @map("exhausted")
  EXPIRED   @map("expired")
}

enum ExecutionRunState {
  AWAITING_APPROVAL @map("awaiting_approval")
  QUEUED            @map("queued")
  RUNNING           @map("running")
  SUCCEEDED         @map("succeeded")
  FAILED            @map("failed")
  CANCELLED         @map("cancelled")
  PAUSED_BUDGET     @map("paused_budget")
}

enum ModelProviderKind {
  DETERMINISTIC @map("deterministic")
  ANTHROPIC     @map("anthropic")
  GATEWAY       @map("gateway")
}

enum ContextClassification {
  PUBLIC     @map("public")
  INTERNAL   @map("internal")
  PRIVATE    @map("private")
  RESTRICTED @map("restricted")
}

enum ApprovalRequestState {
  PENDING   @map("pending")
  APPROVED  @map("approved")
  REJECTED  @map("rejected")
  CANCELLED @map("cancelled")
}

enum ReleaseEvaluationVerdict {
  PASSED @map("passed")
  FAILED @map("failed")
  ERROR  @map("error")
}

enum ReleasePromotionAction {
  PROMOTED    @map("promoted")
  ROLLED_BACK @map("rolled_back")
}

enum AutomationScheduleState {
  ACTIVE @map("active")
  PAUSED @map("paused")
}

enum AutomationCatchUpPolicy {
  LATEST_ONLY @map("latest_only")
  ALL         @map("all")
  NONE        @map("none")
}

enum AutomationBackoff {
  FIXED       @map("fixed")
  EXPONENTIAL @map("exponential")
}

enum AutomationDispatchState {
  PENDING     @map("pending")
  PROCESSING  @map("processing")
  RUN_CREATED @map("run_created")
  FAILED      @map("failed")
}

enum ImprovementCandidateState {
  PROPOSED   @map("proposed")
  INCUBATING @map("incubating")
  REJECTED   @map("rejected")
}

enum MemoryCandidateState {
  STAGED   @map("staged")
  ACCEPTED @map("accepted")
  REJECTED @map("rejected")
}

model AgentFamily {
  id              String   @id @default(uuid()) @db.Uuid
  slug            String   @unique @db.VarChar(160)
  name            String   @db.VarChar(120)
  department      String   @db.VarChar(120)
  owner           String   @db.VarChar(160)
  championAgentId String?  @unique @db.Uuid
  createdBy       String   @db.VarChar(200)
  updatedBy       String   @db.VarChar(200)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  championAgent      Agent?              @relation("FamilyChampion", fields: [championAgentId], references: [id], onDelete: SetNull)
  versions           Agent[]             @relation("FamilyVersions")
  certificationRuns  CertificationRun[]
  promotionDecisions PromotionDecision[]

  @@index([department])
}

model Agent {
  id                   String              @id @default(uuid()) @db.Uuid
  familyId             String              @db.Uuid
  slug                 String              @unique @db.VarChar(160)
  versionNumber        Int
  predecessorAgentId   String?             @db.Uuid
  derivationMode       AgentDerivationMode @default(NEW)
  name                 String              @db.VarChar(120)
  department           String              @db.VarChar(120)
  purpose              String              @db.Text
  owner                String              @db.VarChar(160)
  status               AgentStatus         @default(DRAFT)
  capabilities         Json                @default("[]")
  manifest             Json?
  manifestHash         String?             @db.VarChar(128)
  certificationHealth  CertificationHealth @default(NOT_CERTIFIED)
  degradedAt           DateTime?           @db.Timestamptz(3)
  degradationReason    String?             @db.Text
  activationDecisionId String?             @unique @db.Uuid
  legacyActivation     Boolean             @default(false)
  retirementReason     RetirementReason?
  retiredAt            DateTime?           @db.Timestamptz(3)
  retiredBy            String?             @db.VarChar(200)
  retirementRationale  String?             @db.Text
  successorAgentId     String?             @db.Uuid
  createdBy            String              @db.VarChar(200)
  updatedBy            String              @db.VarChar(200)
  createdAt            DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime            @updatedAt @db.Timestamptz(3)

  family                  AgentFamily            @relation("FamilyVersions", fields: [familyId], references: [id], onDelete: Restrict)
  championForFamily       AgentFamily?           @relation("FamilyChampion")
  predecessorAgent        Agent?                 @relation("AgentPredecessor", fields: [predecessorAgentId], references: [id], onDelete: SetNull)
  successorVersions       Agent[]                @relation("AgentPredecessor")
  successorAgent          Agent?                 @relation("RetirementSuccessor", fields: [successorAgentId], references: [id], onDelete: SetNull)
  supersededVersions      Agent[]                @relation("RetirementSuccessor")
  activationDecision      PromotionDecision?     @relation("ActivationDecision", fields: [activationDecisionId], references: [id], onDelete: SetNull)
  spec                    AgentSpec?             @relation("GeneratedAgent")
  basedSpecs              AgentSpec[]            @relation("BaseAgent")
  generationJobs          GenerationJob[]
  guardrails              Guardrail[]
  evaluationTests         EvaluationTest[]
  knowledgeSources        AgentKnowledgeSource[]
  certificationRuns       CertificationRun[]     @relation("CertificationSubject")
  championComparisonRuns  CertificationRun[]     @relation("CertificationChampion")
  promotionDecisions      PromotionDecision[]    @relation("PromotedVersion")
  priorChampionDecisions  PromotionDecision[]    @relation("PriorChampionVersion")
  platformResourceVersion ResourceVersion?       @relation("LegacyAgentResource")

  @@unique([familyId, versionNumber])
  @@index([familyId, status])
  @@index([status])
  @@index([department])
  @@index([predecessorAgentId])
}

model AgentSpec {
  id                  String                    @id @default(uuid()) @db.Uuid
  agentId             String                    @unique @db.Uuid
  baseAgentId         String?                   @db.Uuid
  derivationMode      AgentDerivationMode       @default(NEW)
  interpretationId    String?                   @unique @db.Uuid
  unconfirmedPrefill  Json?
  status              SpecStatus                @default(DRAFT)
  revision            Int                       @default(1)
  outcomes            Json?
  knowledge           Json?
  guardrails          Json?
  outputs             Json?
  createdBy           String                    @db.VarChar(200)
  updatedBy           String                    @db.VarChar(200)
  createdAt           DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                  @updatedAt @db.Timestamptz(3)
  agent               Agent                     @relation("GeneratedAgent", fields: [agentId], references: [id], onDelete: Cascade)
  baseAgent           Agent?                    @relation("BaseAgent", fields: [baseAgentId], references: [id], onDelete: SetNull)
  interpretation      SpecInterpretation?       @relation("AttachedInterpretation", fields: [interpretationId], references: [id], onDelete: SetNull)
  generationJobs      GenerationJob[]
  confirmations       SpecSectionConfirmation[] @relation("ConfirmedSpec")
  sourceConfirmations SpecSectionConfirmation[] @relation("ConfirmationSourceSpec")

  @@index([status])
  @@index([baseAgentId])
  @@index([derivationMode])
}

model KnowledgeSource {
  id               String                 @id @db.VarChar(100)
  role             SourceRole
  provider         SourceProvider
  displayName      String                 @db.VarChar(160)
  uri              String                 @db.VarChar(500)
  authority        SourceAuthority
  owner            String                 @db.VarChar(160)
  region           String?                @db.VarChar(80)
  lastRefreshed    DateTime?              @db.Timestamptz(3)
  citationRequired Boolean                @default(true)
  readOnly         Boolean                @default(true)
  synthetic        Boolean                @default(false)
  metadata         Json                   @default("{}")
  createdAt        DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @db.Timestamptz(3)
  agents           AgentKnowledgeSource[]

  @@index([role])
  @@index([provider])
}

model AgentKnowledgeSource {
  agentId   String          @db.Uuid
  sourceId  String          @db.VarChar(100)
  purpose   String          @db.VarChar(500)
  citations Boolean
  agent     Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  source    KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@id([agentId, sourceId])
  @@index([sourceId])
}

model Guardrail {
  id          String        @id @default(uuid()) @db.Uuid
  agentId     String        @db.Uuid
  description String        @db.Text
  type        GuardrailType
  parameters  Json          @default("{}")
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)
  agent       Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, type])
}

model EvaluationTest {
  id               String           @id @default(uuid()) @db.Uuid
  agentId          String           @db.Uuid
  name             String           @db.VarChar(160)
  testCase         Json
  expectedResult   Json
  actualResult     Json?
  status           EvaluationStatus @default(NOT_RUN)
  generatorVersion String           @db.VarChar(80)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)
  agent            Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, name, generatorVersion])
  @@index([agentId, status])
}

model GenerationJob {
  id               String             @id @default(uuid()) @db.Uuid
  agentId          String             @db.Uuid
  specId           String             @db.Uuid
  state            GenerationJobState @default(QUEUED)
  progress         Int                @default(0)
  message          String             @default("Queued") @db.VarChar(500)
  specRevision     Int
  generatorVersion String             @db.VarChar(80)
  specSnapshot     Json
  manifest         Json?
  error            Json?
  startedAt        DateTime?          @db.Timestamptz(3)
  finishedAt       DateTime?          @db.Timestamptz(3)
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(3)
  agent            Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  spec             AgentSpec          @relation(fields: [specId], references: [id], onDelete: Cascade)

  @@index([state, createdAt])
  @@index([specId])
}

model CertificationGateConfig {
  id                      String                       @id @default(uuid()) @db.Uuid
  version                 Int                          @unique
  state                   CertificationGateConfigState @default(ACTIVE)
  promotionFreshnessHours Int                          @default(24)
  gates                   Json
  compatibleExecutorKinds ExecutorKind[]               @default([MANIFEST_FIXTURE])
  publishedBy             String                       @db.VarChar(200)
  rationale               String                       @db.Text
  activatedAt             DateTime                     @default(now()) @db.Timestamptz(3)
  supersededAt            DateTime?                    @db.Timestamptz(3)
  createdAt               DateTime                     @default(now()) @db.Timestamptz(3)
  certificationRuns       CertificationRun[]

  @@index([state, version])
}

model EvalCase {
  id                    String           @id @default(uuid()) @db.Uuid
  key                   String           @unique @db.VarChar(160)
  name                  String           @db.VarChar(200)
  input                 Json
  expectedOutput        Json
  expectedCitations     Json             @default("[]")
  tags                  EvalCaseTag[]
  source                EvalCaseSource
  active                Boolean          @default(true)
  provenance            Json             @default("{}")
  createdBy             String           @db.VarChar(200)
  updatedBy             String           @db.VarChar(200)
  deactivatedAt         DateTime?        @db.Timestamptz(3)
  deactivatedBy         String?          @db.VarChar(200)
  deactivationRationale String?          @db.Text
  createdAt             DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @db.Timestamptz(3)
  corpusMemberships     EvalCorpusCase[]
  results               EvalCaseResult[]

  @@index([active, source])
  @@index([tags], type: Gin)
}

model EvalCorpusVersion {
  id                String             @id @default(uuid()) @db.Uuid
  version           Int                @unique
  contentHash       String             @unique @db.VarChar(128)
  publishedBy       String             @db.VarChar(200)
  rationale         String             @db.Text
  publishedAt       DateTime           @default(now()) @db.Timestamptz(3)
  memberships       EvalCorpusCase[]
  certificationRuns CertificationRun[]
}

/// Immutable membership and case snapshot for a published corpus version.
model EvalCorpusCase {
  corpusVersionId String            @db.Uuid
  caseId          String            @db.Uuid
  ordinal         Int
  caseSnapshot    Json
  caseHash        String            @db.VarChar(128)
  corpusVersion   EvalCorpusVersion @relation(fields: [corpusVersionId], references: [id], onDelete: Restrict)
  evalCase        EvalCase          @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@id([corpusVersionId, caseId])
  @@unique([corpusVersionId, ordinal])
  @@index([caseId])
}

model CertificationRun {
  id                          String                           @id @default(uuid()) @db.Uuid
  agentVersionId              String                           @db.Uuid
  subjectResourceVersionId    String?                          @db.Uuid
  comparisonResourceVersionId String?                          @db.Uuid
  familyId                    String                           @db.Uuid
  championVersionId           String?                          @db.Uuid
  kind                        CertificationRunKind
  originStatus                AgentStatus
  state                       CertificationRunState            @default(QUEUED)
  corpusVersionId             String                           @db.Uuid
  corpusVersion               Int
  gateConfigId                String                           @db.Uuid
  gateConfigVersion           Int
  corpusSnapshot              Json
  gateConfigSnapshot          Json
  subjectSnapshot             Json
  championSnapshot            Json?
  subjectManifestSnapshot     Json
  championManifestSnapshot    Json?
  subjectManifestHash         String                           @db.VarChar(128)
  championManifestHash        String?                          @db.VarChar(128)
  specRevision                Int
  generatorVersion            String                           @db.VarChar(80)
  executorKind                ExecutorKind                     @default(MANIFEST_FIXTURE)
  executorVersion             String                           @db.VarChar(80)
  evaluationMode              EvaluationMode                   @default(CORPUS_COVERAGE)
  progress                    Int                              @default(0)
  message                     String                           @default("Queued") @db.VarChar(500)
  totalCaseCount              Int                              @default(0)
  passedCaseCount             Int                              @default(0)
  failedCaseCount             Int                              @default(0)
  verdict                     CertificationVerdict?
  error                       Json?
  requestedBy                 String                           @db.VarChar(200)
  startedBy                   String?                          @db.VarChar(200)
  requestedAt                 DateTime                         @default(now()) @db.Timestamptz(3)
  startedAt                   DateTime?                        @db.Timestamptz(3)
  finishedAt                  DateTime?                        @db.Timestamptz(3)
  promotionExpiresAt          DateTime?                        @db.Timestamptz(3)
  nightlyScheduleKey          String?                          @unique @db.VarChar(160)
  isPromotionEvidence         Boolean                          @default(false)
  resultsAvailability         CertificationResultsAvailability @default(FULL)
  caseResultsPrunedAt         DateTime?                        @db.Timestamptz(3)
  subjectAgent                Agent                            @relation("CertificationSubject", fields: [agentVersionId], references: [id], onDelete: Restrict)
  family                      AgentFamily                      @relation(fields: [familyId], references: [id], onDelete: Restrict)
  championAgent               Agent?                           @relation("CertificationChampion", fields: [championVersionId], references: [id], onDelete: Restrict)
  corpus                      EvalCorpusVersion                @relation(fields: [corpusVersionId], references: [id], onDelete: Restrict)
  gateConfig                  CertificationGateConfig          @relation(fields: [gateConfigId], references: [id], onDelete: Restrict)
  gateResults                 CertificationGateResult[]
  caseResults                 EvalCaseResult[]
  promotionDecision           PromotionDecision?
  subjectResourceVersion      ResourceVersion?                 @relation("CertificationResourceSubject", fields: [subjectResourceVersionId], references: [id], onDelete: Restrict)
  comparisonResourceVersion   ResourceVersion?                 @relation("CertificationResourceComparison", fields: [comparisonResourceVersionId], references: [id], onDelete: Restrict)

  @@index([agentVersionId, requestedAt])
  @@index([familyId, requestedAt])
  @@index([state, requestedAt])
  @@index([corpusVersionId])
  @@index([gateConfigId])
  @@index([subjectResourceVersionId, requestedAt])
  @@index([comparisonResourceVersionId])
}

model CertificationGateResult {
  id              String                        @id @default(uuid()) @db.Uuid
  runId           String                        @db.Uuid
  gate            CertificationGateKey
  operator        CertificationGateOperator
  threshold       Float
  championScore   Float?
  challengerScore Float?
  measuredValue   Float?
  status          CertificationGateResultStatus
  details         Json                          @default("{}")
  createdAt       DateTime                      @default(now()) @db.Timestamptz(3)
  run             CertificationRun              @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, gate])
  @@index([runId, status])
}

model EvalCaseResult {
  id                  String           @id @default(uuid()) @db.Uuid
  runId               String           @db.Uuid
  caseId              String           @db.Uuid
  caseKey             String           @db.VarChar(160)
  caseName            String           @db.VarChar(200)
  tags                EvalCaseTag[]
  input               Json
  expectedOutput      Json
  expectedCitations   Json             @default("[]")
  championOutput      Json?
  challengerOutput    Json
  championCitations   Json             @default("[]")
  challengerCitations Json             @default("[]")
  championActions     Json             @default("[]")
  challengerActions   Json             @default("[]")
  scoreBreakdown      Json
  diff                Json
  passed              Boolean
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)
  run                 CertificationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  evalCase            EvalCase         @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@unique([runId, caseId])
  @@index([runId, passed, caseKey])
  @@index([caseId])
}

/// Immutable human decision linked to its audit event and evidence run.
model PromotionDecision {
  id                     String                @id @default(uuid()) @db.Uuid
  runId                  String                @unique @db.Uuid
  familyId               String                @db.Uuid
  agentVersionId         String                @db.Uuid
  priorChampionVersionId String?               @db.Uuid
  decision               PromotionDecisionType
  decidedBy              String                @db.VarChar(200)
  rationale              String                @db.Text
  auditEventId           String                @unique @db.Uuid
  decidedAt              DateTime              @default(now()) @db.Timestamptz(3)
  run                    CertificationRun      @relation(fields: [runId], references: [id], onDelete: Restrict)
  family                 AgentFamily           @relation(fields: [familyId], references: [id], onDelete: Restrict)
  agentVersion           Agent                 @relation("PromotedVersion", fields: [agentVersionId], references: [id], onDelete: Restrict)
  priorChampionVersion   Agent?                @relation("PriorChampionVersion", fields: [priorChampionVersionId], references: [id], onDelete: Restrict)
  activatedAgent         Agent?                @relation("ActivationDecision")
  auditEvent             AuditEvent            @relation("PromotionAuditEvent", fields: [auditEventId], references: [id], onDelete: Restrict)

  @@index([familyId, decidedAt])
  @@index([agentVersionId])
}

model SpecInterpretation {
  id                     String                    @id @default(uuid()) @db.Uuid
  parentInterpretationId String?                   @db.Uuid
  prompt                 String                    @db.Text
  promptHash             String                    @db.VarChar(128)
  result                 Json
  createdBy              String                    @db.VarChar(200)
  expiresAt              DateTime                  @db.Timestamptz(3)
  createdAt              DateTime                  @default(now()) @db.Timestamptz(3)
  parentInterpretation   SpecInterpretation?       @relation("InterpretationTree", fields: [parentInterpretationId], references: [id], onDelete: Restrict)
  childInterpretations   SpecInterpretation[]      @relation("InterpretationTree")
  attachedSpec           AgentSpec?                @relation("AttachedInterpretation")
  confirmations          SpecSectionConfirmation[]

  @@index([parentInterpretationId])
  @@index([expiresAt])
  @@index([promptHash])
}

/// Append-only record proving which human confirmed each canonical spec section.
model SpecSectionConfirmation {
  id                 String                  @id @default(uuid()) @db.Uuid
  specId             String                  @db.Uuid
  interpretationId   String?                 @db.Uuid
  section            SpecSection
  specRevision       Int
  kind               SectionConfirmationKind
  sourceSpecId       String?                 @db.Uuid
  sourceSpecRevision Int?
  resolutions        Json                    @default("[]")
  actorId            String                  @db.VarChar(200)
  createdAt          DateTime                @default(now()) @db.Timestamptz(3)
  spec               AgentSpec               @relation("ConfirmedSpec", fields: [specId], references: [id], onDelete: Restrict)
  interpretation     SpecInterpretation?     @relation(fields: [interpretationId], references: [id], onDelete: Restrict)
  sourceSpec         AgentSpec?              @relation("ConfirmationSourceSpec", fields: [sourceSpecId], references: [id], onDelete: Restrict)

  @@unique([specId, section, specRevision])
  @@index([interpretationId])
  @@index([sourceSpecId])
}

/// Append-only governance record. Database triggers reject UPDATE and DELETE operations.
model AuditEvent {
  id                String             @id @default(uuid()) @db.Uuid
  actorId           String             @db.VarChar(200)
  requestId         String?            @db.VarChar(200)
  action            String             @db.VarChar(120)
  entityType        String             @db.VarChar(80)
  entityId          String             @db.VarChar(200)
  details           Json               @default("{}")
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  promotionDecision PromotionDecision? @relation("PromotionAuditEvent")

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model ResourceFamily {
  id        String            @id @default(uuid()) @db.Uuid
  kind      ResourceKind
  slug      String            @db.VarChar(160)
  name      String            @db.VarChar(160)
  createdBy String            @db.VarChar(200)
  updatedBy String            @db.VarChar(200)
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @db.Timestamptz(3)
  versions  ResourceVersion[]

  @@unique([kind, slug])
  @@index([kind, name])
}

model ResourceVersion {
  id                          String              @id @default(uuid()) @db.Uuid
  familyId                    String              @db.Uuid
  legacyAgentId               String?             @unique @db.Uuid
  version                     String              @db.VarChar(80)
  lifecycle                   ResourceLifecycle
  owner                       String              @db.VarChar(200)
  purpose                     String              @db.Text
  definition                  Json
  digest                      String              @unique @db.VarChar(64)
  sourceCommit                String              @db.VarChar(160)
  provenance                  Json                @default("{}")
  dependencyPins              Json                @default("[]")
  revision                    Int                 @default(1)
  frozenAt                    DateTime?           @db.Timestamptz(3)
  createdBy                   String              @db.VarChar(200)
  updatedBy                   String              @db.VarChar(200)
  createdAt                   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime            @updatedAt @db.Timestamptz(3)
  family                      ResourceFamily      @relation(fields: [familyId], references: [id], onDelete: Restrict)
  legacyAgent                 Agent?              @relation("LegacyAgentResource", fields: [legacyAgentId], references: [id], onDelete: Restrict)
  imports                     RepositoryImport[]
  releases                    ReleaseResource[]
  releaseEvaluations          ReleaseEvaluation[]
  certificationSubjectRuns    CertificationRun[]  @relation("CertificationResourceSubject")
  certificationComparisonRuns CertificationRun[]  @relation("CertificationResourceComparison")

  @@unique([familyId, version])
  @@index([familyId, lifecycle])
}

model RepositoryImport {
  id                     String                @id @default(uuid()) @db.Uuid
  resourceVersionId      String                @db.Uuid
  improvementCandidateId String?               @db.Uuid
  digest                 String                @db.VarChar(64)
  sourceCommit           String                @db.VarChar(160)
  sourcePath             String?               @db.VarChar(500)
  manifestSnapshot       Json
  importedBy             String                @db.VarChar(200)
  importedAt             DateTime              @default(now()) @db.Timestamptz(3)
  resourceVersion        ResourceVersion       @relation(fields: [resourceVersionId], references: [id], onDelete: Restrict)
  improvementCandidate   ImprovementCandidate? @relation(fields: [improvementCandidateId], references: [id], onDelete: Restrict)

  @@unique([resourceVersionId, digest])
  @@index([sourceCommit, importedAt])
  @@index([improvementCandidateId])
}

model ReleaseBundle {
  id                  String                     @id @default(uuid()) @db.Uuid
  digest              String                     @unique @db.VarChar(64)
  projectId           String?                    @db.VarChar(160)
  createdBy           String                     @db.VarChar(200)
  createdAt           DateTime                   @default(now()) @db.Timestamptz(3)
  resources           ReleaseResource[]
  authorityGrants     AuthorityGrant[]
  executionRuns       ExecutionRun[]
  evaluations         ReleaseEvaluation[]
  promotionTargets    ReleasePromotionDecision[] @relation("ReleasePromotionTarget")
  promotionPrevious   ReleasePromotionDecision[] @relation("ReleasePromotionPrevious")
  activeChannels      ProductionChannel[]        @relation("ProductionChannelCurrent")
  priorChannels       ProductionChannel[]        @relation("ProductionChannelPrior")
  automationSchedules AutomationSchedule[]
}

model ReleaseResource {
  releaseId         String          @db.Uuid
  resourceVersionId String          @db.Uuid
  kind              ResourceKind
  digest            String          @db.VarChar(64)
  ordinal           Int
  release           ReleaseBundle   @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  resourceVersion   ResourceVersion @relation(fields: [resourceVersionId], references: [id], onDelete: Restrict)

  @@id([releaseId, resourceVersionId])
  @@unique([releaseId, ordinal])
  @@index([resourceVersionId])
}

model ReleaseEvaluation {
  id                    String                     @id @default(uuid()) @db.Uuid
  releaseId             String                     @db.Uuid
  releaseDigest         String                     @db.VarChar(64)
  suiteVersionId        String                     @db.Uuid
  suiteDigest           String                     @db.VarChar(64)
  executorKind          String                     @db.VarChar(100)
  executorVersion       String                     @db.VarChar(80)
  evaluationMode        String                     @db.VarChar(100)
  historySnapshotDigest String                     @db.VarChar(64)
  corpusVersion         Int
  verdict               ReleaseEvaluationVerdict
  results               Json
  gateScores            Json
  evidence              Json
  requestedBy           String                     @db.VarChar(200)
  createdAt             DateTime                   @default(now()) @db.Timestamptz(3)
  finishedAt            DateTime                   @db.Timestamptz(3)
  release               ReleaseBundle              @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  suiteVersion          ResourceVersion            @relation(fields: [suiteVersionId], references: [id], onDelete: Restrict)
  promotionDecisions    ReleasePromotionDecision[]

  @@unique([releaseId, suiteVersionId, suiteDigest, executorKind, executorVersion, evaluationMode, historySnapshotDigest], map: "ReleaseEvaluation_evidence_snapshot_key")
  @@index([releaseId, verdict, finishedAt])
  @@index([suiteVersionId, finishedAt])
}

model ProductionChannel {
  key                 String                     @id @db.VarChar(160)
  projectId           String?                    @unique @db.VarChar(160)
  currentReleaseId    String?                    @db.Uuid
  priorReleaseId      String?                    @db.Uuid
  promotedBy          String?                    @db.VarChar(200)
  promotedAt          DateTime?                  @db.Timestamptz(3)
  updatedAt           DateTime                   @updatedAt @db.Timestamptz(3)
  currentRelease      ReleaseBundle?             @relation("ProductionChannelCurrent", fields: [currentReleaseId], references: [id], onDelete: Restrict)
  priorRelease        ReleaseBundle?             @relation("ProductionChannelPrior", fields: [priorReleaseId], references: [id], onDelete: Restrict)
  decisions           ReleasePromotionDecision[]
  automationSchedules AutomationSchedule[]
}

model ReleasePromotionDecision {
  id                String                 @id @default(uuid()) @db.Uuid
  channelKey        String                 @db.VarChar(160)
  action            ReleasePromotionAction
  releaseId         String                 @db.Uuid
  previousReleaseId String?                @db.Uuid
  evaluationId      String                 @db.Uuid
  rationale         String                 @db.Text
  decidedBy         String                 @db.VarChar(200)
  decidedAt         DateTime               @default(now()) @db.Timestamptz(3)
  channel           ProductionChannel      @relation(fields: [channelKey], references: [key], onDelete: Restrict)
  release           ReleaseBundle          @relation("ReleasePromotionTarget", fields: [releaseId], references: [id], onDelete: Restrict)
  previousRelease   ReleaseBundle?         @relation("ReleasePromotionPrevious", fields: [previousReleaseId], references: [id], onDelete: Restrict)
  evaluation        ReleaseEvaluation      @relation(fields: [evaluationId], references: [id], onDelete: Restrict)

  @@index([channelKey, decidedAt])
  @@index([releaseId, decidedAt])
}

model AuthorityGrant {
  id                        String               @id @default(uuid()) @db.Uuid
  releaseId                 String               @db.Uuid
  releaseDigest             String               @db.VarChar(64)
  contextDigest             String               @db.VarChar(64)
  projectId                 String?              @db.VarChar(160)
  inputConstraints          Json                 @default("{}")
  toolScopes                Json                 @default("[]")
  validFrom                 DateTime             @default(now()) @db.Timestamptz(3)
  validUntil                DateTime             @db.Timestamptz(3)
  maxRuns                   Int
  usedRuns                  Int                  @default(0)
  maxEstimatedCostPerRunUsd Decimal              @db.Decimal(18, 8)
  totalCostBudgetUsd        Decimal              @db.Decimal(18, 8)
  spentCostUsd              Decimal              @default(0) @db.Decimal(18, 8)
  reservedCostUsd           Decimal              @default(0) @db.Decimal(18, 8)
  state                     AuthorityGrantState  @default(ACTIVE)
  actorId                   String               @db.VarChar(200)
  rationale                 String               @db.Text
  revokedAt                 DateTime?            @db.Timestamptz(3)
  revokedBy                 String?              @db.VarChar(200)
  createdAt                 DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime             @updatedAt @db.Timestamptz(3)
  release                   ReleaseBundle        @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  executionRuns             ExecutionRun[]
  automationSchedules       AutomationSchedule[]

  @@index([releaseId, state, validUntil])
  @@index([actorId, createdAt])
}

model ExecutionRun {
  id                     String                @id @default(uuid()) @db.Uuid
  releaseId              String                @db.Uuid
  authorityGrantId       String?               @db.Uuid
  releaseDigest          String                @db.VarChar(64)
  contextDigest          String                @db.VarChar(64)
  contextProvenance      Json                  @default("[]")
  contextClassification  ContextClassification @default(PUBLIC)
  contextEstimatedTokens Int                   @default(0)
  projectId              String?               @db.VarChar(160)
  requiredToolScopes     Json                  @default("[]")
  state                  ExecutionRunState     @default(AWAITING_APPROVAL)
  input                  Json
  providerKind           ModelProviderKind
  developmentDraft       Boolean               @default(false)
  providerVersion        String                @db.VarChar(80)
  model                  String                @db.VarChar(160)
  maxInputTokens         Int
  maxOutputTokens        Int
  maxEstimatedCostUsd    Decimal               @db.Decimal(18, 8)
  estimatedUpperCostUsd  Decimal               @db.Decimal(18, 8)
  actualCostUsd          Decimal?              @db.Decimal(18, 8)
  pricingVersion         String                @db.VarChar(80)
  approvalReasons        Json                  @default("[]")
  progress               Int                   @default(0)
  message                String                @default("Awaiting approval") @db.VarChar(500)
  idempotencyKey         String                @unique @db.VarChar(200)
  requestedBy            String                @db.VarChar(200)
  attempts               Int                   @default(0)
  maxAttempts            Int                   @default(3)
  leaseOwner             String?               @db.VarChar(200)
  leaseExpiresAt         DateTime?             @db.Timestamptz(3)
  heartbeatAt            DateTime?             @db.Timestamptz(3)
  cancelRequestedAt      DateTime?             @db.Timestamptz(3)
  error                  Json?
  startedAt              DateTime?             @db.Timestamptz(3)
  finishedAt             DateTime?             @db.Timestamptz(3)
  createdAt              DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime              @updatedAt @db.Timestamptz(3)
  release                ReleaseBundle         @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  authorityGrant         AuthorityGrant?       @relation(fields: [authorityGrantId], references: [id], onDelete: Restrict)
  outcome                OutcomeRecord?
  metrics                MetricSample[]
  steps                  RunStep[]
  approvalRequest        ApprovalRequest?
  automationDispatch     AutomationDispatch?
  observations           Observation[]
  memoryCandidates       MemoryCandidate[]

  @@index([state, createdAt])
  @@index([leaseExpiresAt])
  @@index([authorityGrantId, createdAt])
}

model ApprovalRequest {
  id          String               @id @default(uuid()) @db.Uuid
  runId       String               @unique @db.Uuid
  state       ApprovalRequestState @default(PENDING)
  reasons     Json                 @default("[]")
  requestedBy String               @db.VarChar(200)
  decidedBy   String?              @db.VarChar(200)
  rationale   String?              @db.Text
  decidedAt   DateTime?            @db.Timestamptz(3)
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)
  run         ExecutionRun         @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@index([state, createdAt])
}

model RunStep {
  id             String       @id @default(uuid()) @db.Uuid
  runId          String       @db.Uuid
  stepKey        String       @db.VarChar(160)
  idempotencyKey String       @unique @db.VarChar(240)
  state          String       @db.VarChar(40)
  result         Json?
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  run            ExecutionRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@unique([runId, stepKey])
  @@index([runId, state])
}

model OutcomeRecord {
  id              String        @id @default(uuid()) @db.Uuid
  runId           String        @unique @db.Uuid
  output          Json
  confidence      Float?
  citations       Json          @default("[]")
  unresolvedItems Json          @default("[]")
  qualityScore    Float?
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  run             ExecutionRun  @relation(fields: [runId], references: [id], onDelete: Restrict)
  observations    Observation[]
}

model MetricSample {
  id         String        @id @default(uuid()) @db.Uuid
  runId      String?       @db.Uuid
  name       String        @db.VarChar(160)
  value      Float
  unit       String        @db.VarChar(40)
  metadata   Json          @default("{}")
  observedAt DateTime      @default(now()) @db.Timestamptz(3)
  run        ExecutionRun? @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@index([runId, observedAt])
  @@index([name, observedAt])
}

model AutomationSchedule {
  id                         String                  @id @default(uuid()) @db.Uuid
  name                       String                  @db.VarChar(160)
  channelKey                 String                  @db.VarChar(160)
  releaseId                  String                  @db.Uuid
  releaseDigest              String                  @db.VarChar(64)
  projectId                  String?                 @db.VarChar(160)
  authorityGrantId           String?                 @db.Uuid
  timezone                   String                  @db.VarChar(100)
  intervalSeconds            Int
  nextRunAt                  DateTime                @db.Timestamptz(3)
  inputTemplate              Json
  inputConstraints           Json                    @default("{}")
  catchUpPolicy              AutomationCatchUpPolicy @default(LATEST_ONLY)
  maxCatchUpRuns             Int                     @default(10)
  deduplicationWindowSeconds Int                     @default(300)
  maximumAttempts            Int                     @default(3)
  backoff                    AutomationBackoff       @default(EXPONENTIAL)
  maxInputTokens             Int
  maxOutputTokens            Int
  maxEstimatedCostUsd        Decimal                 @db.Decimal(18, 8)
  outcomeExpectations        Json                    @default("{}")
  state                      AutomationScheduleState @default(ACTIVE)
  lastScheduledAt            DateTime?               @db.Timestamptz(3)
  createdBy                  String                  @db.VarChar(200)
  updatedBy                  String                  @db.VarChar(200)
  createdAt                  DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime                @updatedAt @db.Timestamptz(3)
  channel                    ProductionChannel       @relation(fields: [channelKey], references: [key], onDelete: Restrict)
  release                    ReleaseBundle           @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  authorityGrant             AuthorityGrant?         @relation(fields: [authorityGrantId], references: [id], onDelete: Restrict)
  dispatches                 AutomationDispatch[]

  @@index([state, nextRunAt])
  @@index([channelKey, state])
  @@index([authorityGrantId])
}

model AutomationDispatch {
  id             String                  @id @default(uuid()) @db.Uuid
  scheduleId     String                  @db.Uuid
  scheduledFor   DateTime                @db.Timestamptz(3)
  idempotencyKey String                  @unique @db.VarChar(200)
  state          AutomationDispatchState @default(PENDING)
  claimToken     String?                 @db.VarChar(100)
  leaseExpiresAt DateTime?               @db.Timestamptz(3)
  runId          String?                 @unique @db.Uuid
  error          Json?
  createdAt      DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @db.Timestamptz(3)
  schedule       AutomationSchedule      @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  run            ExecutionRun?           @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@unique([scheduleId, scheduledFor])
  @@index([state, createdAt])
  @@index([state, leaseExpiresAt])
}

model Observation {
  id              String                 @id @default(uuid()) @db.Uuid
  signalKey       String                 @unique @db.VarChar(200)
  signalType      String                 @db.VarChar(120)
  summary         String                 @db.Text
  evidence        Json                   @default("{}")
  provenance      Json                   @default("{}")
  sourceRunId     String?                @db.Uuid
  sourceOutcomeId String?                @db.Uuid
  observedBy      String                 @db.VarChar(200)
  observedAt      DateTime               @default(now()) @db.Timestamptz(3)
  sourceRun       ExecutionRun?          @relation(fields: [sourceRunId], references: [id], onDelete: Restrict)
  sourceOutcome   OutcomeRecord?         @relation(fields: [sourceOutcomeId], references: [id], onDelete: Restrict)
  candidates      ImprovementCandidate[]

  @@index([sourceRunId, observedAt])
  @@index([signalType, observedAt])
}

model ImprovementCandidate {
  id                String                    @id @default(uuid()) @db.Uuid
  observationId     String                    @db.Uuid
  title             String                    @db.VarChar(200)
  proposedTarget    String                    @db.VarChar(200)
  proposedChange    String                    @db.Text
  evidenceRefs      Json                      @default("[]")
  state             ImprovementCandidateState @default(PROPOSED)
  createdBy         String                    @db.VarChar(200)
  reviewedBy        String?                   @db.VarChar(200)
  reviewRationale   String?                   @db.Text
  createdAt         DateTime                  @default(now()) @db.Timestamptz(3)
  reviewedAt        DateTime?                 @db.Timestamptz(3)
  observation       Observation               @relation(fields: [observationId], references: [id], onDelete: Restrict)
  repositoryImports RepositoryImport[]

  @@index([state, createdAt])
  @@index([observationId])
}

model MemoryCandidate {
  id              String               @id @default(uuid()) @db.Uuid
  sourceRunId     String               @db.Uuid
  namespace       String               @db.VarChar(160)
  proposedValue   Json
  acceptedValue   Json?
  provenance      Json                 @default("{}")
  state           MemoryCandidateState @default(STAGED)
  stagedBy        String               @db.VarChar(200)
  reviewedBy      String?              @db.VarChar(200)
  reviewRationale String?              @db.Text
  stagedAt        DateTime             @default(now()) @db.Timestamptz(3)
  reviewedAt      DateTime?            @db.Timestamptz(3)
  sourceRun       ExecutionRun         @relation(fields: [sourceRunId], references: [id], onDelete: Restrict)

  @@unique([sourceRunId, namespace])
  @@index([state, stagedAt])
}
