  comparisonResourceVersion   ResourceVersion?                 @relation("CertificationResourceComparison", fields: [comparisonResourceVersionId], references: [id], onDelete: Restrict)

  @@unique([familyId, nightlyScheduleKey])
  @@index([agentVersionId, requestedAt])
  @@index([familyId, requestedAt])
  @@index([state, requestedAt])
  @@index([corpusVersionId])
  @@index([gateConfigId])
  @@index([subjectResourceVersionId, requestedAt])
  @@index([comparisonResourceVersionId])
}

