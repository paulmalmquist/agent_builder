  occurredAt   DateTime    @default(now()) @db.Timestamptz(3)
  workspace    Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  department   Department? @relation(fields: [departmentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@index([workspaceId, departmentId, sequence])
  @@index([workspaceId, actorId, sequence])
}

/// Mutable delivery high-water mark. Failed delivery attempts never advance this cursor.
model AttentionCursor {
  id                         String      @id @default(uuid()) @db.Uuid
  workspaceId                String      @db.Uuid
  departmentId               String?     @db.Uuid
  departmentScopeKey         String      @db.VarChar(40)
  actorId                    String      @db.VarChar(200)
  lastDeliveredEventSequence BigInt      @default(0)
  lastDeliveredAt            DateTime?   @db.Timestamptz(3)
  createdAt                  DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime    @updatedAt @db.Timestamptz(3)
  workspace                  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  department                 Department? @relation(fields: [departmentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@unique([workspaceId, departmentScopeKey, actorId])
  @@index([workspaceId, departmentId, updatedAt])
}

/// Immutable digest content. Delivery state is derived from append-only attempts.
model DigestSnapshot {
  id                   String                  @id @default(uuid()) @db.Uuid
  workspaceId          String                  @db.Uuid
  departmentId         String?                 @db.Uuid
  departmentScopeKey   String                  @db.VarChar(40)
  actorId              String                  @db.VarChar(200)
  windowStartedAt      DateTime                @db.Timestamptz(3)
  windowEndedAt        DateTime                @db.Timestamptz(3)
  eventSequenceFrom    BigInt
  eventSequenceThrough BigInt
  summary              Json
  createdAt            DateTime                @default(now()) @db.Timestamptz(3)
  attempts             DigestDeliveryAttempt[]
  briefingRuns         ExecutionRun[]          @relation("BriefingDigestSnapshot")
  workspace            Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  department           Department?             @relation(fields: [departmentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@unique([workspaceId, departmentScopeKey, actorId, eventSequenceFrom, eventSequenceThrough], map: "DigestSnapshot_scope_actor_window_key")
  @@index([workspaceId, departmentId, createdAt])
}

/// Append-only record of a briefing delivery attempt.
model DigestDeliveryAttempt {
  id            String                     @id @default(uuid()) @db.Uuid
  workspaceId   String                     @db.Uuid
  departmentId  String?                    @db.Uuid
  snapshotId    String                     @db.Uuid
  attemptKey    String                     @db.VarChar(240)
  state         DigestDeliveryAttemptState
  briefingRunId String?                    @db.Uuid
  error         Json?
  createdAt     DateTime                   @default(now()) @db.Timestamptz(3)
  deliveredAt   DateTime?                  @db.Timestamptz(3)
  snapshot      DigestSnapshot             @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  briefingRun   ExecutionRun?              @relation(fields: [briefingRunId], references: [id], onDelete: Restrict)
  workspace     Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  department    Department?                @relation(fields: [departmentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@unique([workspaceId, attemptKey])
  @@index([workspaceId, departmentId, createdAt])
  @@index([snapshotId, createdAt])
}

/// Append-only human acknowledgement that removes a terminal degraded item from Attention.
model AttentionResolution {
  id                 String      @id @default(uuid()) @db.Uuid
  workspaceId        String      @db.Uuid
  departmentId       String?     @db.Uuid
  departmentScopeKey String      @db.VarChar(40)
  itemId             String      @db.VarChar(320)
  rationale          String      @db.Text
  resolvedBy         String      @db.VarChar(200)
  resolvedAt         DateTime    @default(now()) @db.Timestamptz(3)
  workspace          Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  department         Department? @relation(fields: [departmentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@unique([workspaceId, departmentScopeKey, itemId], map: "AttentionResolution_scope_item_key")
  @@index([workspaceId, departmentId, resolvedAt])
}

/// Governed capability metadata for an exact Agent or Skill resource version.
model CapabilityProfile {
  id                String               @id @default(uuid()) @db.Uuid
  workspaceId       String               @db.Uuid
  departmentId      String?              @db.Uuid
  resourceVersionId String               @unique @db.Uuid
  schemaVersion     Int                  @default(1)
  profile           Json
  digest            String               @db.VarChar(64)
  createdBy         String               @db.VarChar(200)
  createdAt         DateTime             @default(now()) @db.Timestamptz(3)
  resourceVersion   ResourceVersion      @relation(fields: [resourceVersionId], references: [id], onDelete: Restrict)
  publications      CatalogPublication[]
  workspace         Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  department        Department?          @relation(fields: [departmentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@index([workspaceId, departmentId, createdAt])
  @@index([digest])
}

/// A prepared publication is inert until the containing certified release is promoted.
model CatalogPublication {
  id                     String                    @id @default(uuid()) @db.Uuid
  workspaceId            String                    @db.Uuid
  departmentId           String?                   @db.Uuid
  resourceVersionId      String                    @db.Uuid
  releaseId              String                    @db.Uuid
  capabilityProfileId    String                    @db.Uuid
  activationEvaluationId String?                   @db.Uuid
  activationDecisionId   String?                   @db.Uuid
  revision               Int                       @default(1)
  subjectKind            ResourceKind
  catalogVisibility      CatalogVisibility
  trustChip              Json?
  state                  CatalogPublicationState   @default(PREPARED)
  preparedBy             String                    @db.VarChar(200)
  preparedAt             DateTime                  @default(now()) @db.Timestamptz(3)
  publishedAt            DateTime?                 @db.Timestamptz(3)
  retiredAt              DateTime?                 @db.Timestamptz(3)
  retiredBy              String?                   @db.VarChar(200)
  retirementRationale    String?                   @db.Text
  resourceVersion        ResourceVersion           @relation(fields: [resourceVersionId], references: [id], onDelete: Restrict)
  release                ReleaseBundle             @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  capabilityProfile      CapabilityProfile         @relation(fields: [capabilityProfileId], references: [id], onDelete: Restrict)
  activationEvaluation   ReleaseEvaluation?        @relation(fields: [activationEvaluationId], references: [id], onDelete: Restrict)
  activationDecision     ReleasePromotionDecision? @relation(fields: [activationDecisionId], references: [id], onDelete: Restrict)
  outboxEvents           CatalogIndexOutbox[]
  indexRecord            CatalogIndexRecord?
  selectedDecisions      BuilderDecision[]         @relation("BuilderDecisionSelectedPublication")
  builderDrafts          BuilderDraft[]            @relation("BuilderDraftBasePublication")
  deployments            Deployment[]              @relation("DeploymentSourcePublication")
  workspace              Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  department             Department?               @relation(fields: [departmentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@unique([releaseId, resourceVersionId])
  @@index([workspaceId, departmentId, state, catalogVisibility])
  @@index([resourceVersionId, state])
  @@index([releaseId, state])
}

/// Transactional indexing request. Payloads contain only governed catalog metadata.
model CatalogIndexOutbox {
  id                  String                  @id @default(uuid()) @db.Uuid
  workspaceId         String                  @db.Uuid
  departmentId        String?                 @db.Uuid
  publicationId       String                  @db.Uuid
  publicationRevision Int
  idempotencyKey      String                  @db.VarChar(500)
  operation           CatalogIndexOperation
  resource            Json
  state               CatalogIndexOutboxState @default(PENDING)
  attempts            Int                     @default(0)
  occurredAt          DateTime                @default(now()) @db.Timestamptz(3)
  availableAt         DateTime                @default(now()) @db.Timestamptz(3)
  claimedAt           DateTime?               @db.Timestamptz(3)
  publishedAt         DateTime?               @db.Timestamptz(3)
  lastError           String?                 @db.VarChar(2000)
  publication         CatalogPublication      @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  workspace           Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  department          Department?             @relation(fields: [departmentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@unique([workspaceId, idempotencyKey])
  @@index([state, availableAt, occurredAt])
  @@index([workspaceId, departmentId, occurredAt])
  @@index([publicationId, publicationRevision])
}

/// Materialized read model used for matching. Embeddings never leave this persistence boundary.
model CatalogIndexRecord {
  publicationId       String             @id @db.Uuid
  workspaceId         String             @db.Uuid
  departmentId        String?            @db.Uuid
  publicationRevision Int
  subjectKind         ResourceKind
  resourceVersionId   String             @db.Uuid
  releaseDigest       String             @db.VarChar(64)
  catalogVisibility   CatalogVisibility
  departmentLabel     String             @db.VarChar(160)
  featureKeys         Json
  canonicalText       String             @db.Text
  embedding           Json?
  embeddingProvenance Json?
  retired             Boolean            @default(false)
  indexedAt           DateTime           @db.Timestamptz(3)
  publication         CatalogPublication @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  workspace           Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  department          Department?        @relation(fields: [departmentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@index([workspaceId, departmentId, retired, subjectKind])
  @@index([resourceVersionId])
}

model BuilderIntake {
  id                String             @id @default(uuid()) @db.Uuid
  workspaceId       String             @db.Uuid
  departmentId      String?            @db.Uuid
  request           String             @db.Text
  requestedBy       String             @db.VarChar(200)
  departmentLabel   String             @db.VarChar(160)
  state             BuilderIntakeState
  capabilityProfile Json
  confirmedAt       DateTime?          @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  decisions         BuilderDecision[]
  drafts            BuilderDraft[]
  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  department        Department?        @relation(fields: [departmentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@index([workspaceId, departmentId, createdAt])
  @@index([state, createdAt])
}

/// Immutable and idempotent choice made before any legacy specification is created.
model BuilderDecision {
  id                        String                @id @default(uuid()) @db.Uuid
  workspaceId               String                @db.Uuid
  departmentId              String?               @db.Uuid
  intakeId                  String                @unique @db.Uuid
  idempotencyKey            String                @db.VarChar(200)
  action                    BuilderDecisionAction
  selectedPublicationId     String?               @db.Uuid
  buildNewReason            String?               @db.VarChar(500)
  demandObservationId       String?               @unique @db.Uuid
  highestReferredMatchScore Float?
  decidedBy                 String                @db.VarChar(200)
  decidedAt                 DateTime              @default(now()) @db.Timestamptz(3)
  intake                    BuilderIntake         @relation(fields: [intakeId], references: [id], onDelete: Restrict)
  selectedPublication       CatalogPublication?   @relation("BuilderDecisionSelectedPublication", fields: [selectedPublicationId], references: [id], onDelete: Restrict)
  demandObservation         Observation?          @relation(fields: [demandObservationId], references: [id], onDelete: Restrict)
  deployment                Deployment?
  drafts                    BuilderDraft[]
  lineage                   ResourceLineage[]
  workspace                 Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  department                Department?           @relation(fields: [departmentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, departmentId, decidedAt])
  @@index([selectedPublicationId, decidedAt])
}

model BuilderDraft {
  id                            String              @id @default(uuid()) @db.Uuid
  workspaceId                   String              @db.Uuid
  departmentId                  String?             @db.Uuid
  intakeId                      String              @db.Uuid
  decisionId                    String              @db.Uuid
  draftKind                     BuilderDraftKind
  basePublicationId             String?             @db.Uuid
  materializedResourceVersionId String?             @db.Uuid
  capabilityProfile             Json
  definition                    Json                @default("{}")
  revision                      Int                 @default(1)
  state                         BuilderDraftState   @default(DRAFT)
  createdBy                     String              @db.VarChar(200)
  createdAt                     DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt                     DateTime            @updatedAt @db.Timestamptz(3)
  intake                        BuilderIntake       @relation(fields: [intakeId], references: [id], onDelete: Restrict)
  decision                      BuilderDecision     @relation(fields: [decisionId], references: [id], onDelete: Restrict)
  basePublication               CatalogPublication? @relation("BuilderDraftBasePublication", fields: [basePublicationId], references: [id], onDelete: Restrict)
  materializedResourceVersion   ResourceVersion?    @relation("BuilderDraftMaterializedResource", fields: [materializedResourceVersionId], references: [id], onDelete: Restrict)
  workspace                     Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  department                    Department?         @relation(fields: [departmentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@unique([decisionId, draftKind])
  @@index([workspaceId, departmentId, state, updatedAt])
  @@index([basePublicationId])
}

model Deployment {
  id                             String                  @id @default(uuid()) @db.Uuid
  workspaceId                    String                  @db.Uuid
  departmentId                   String?                 @db.Uuid
  decisionId                     String                  @unique @db.Uuid
  deployedResourceVersionId      String                  @db.Uuid
  sourcePublicationId            String?                 @db.Uuid
  projectId                      String                  @db.VarChar(200)
  currentConfigurationRevisionId String?                 @db.Uuid
  status                         DeploymentStatus        @default(ACTIVE)
  sourceRetiredAt                DateTime?               @db.Timestamptz(3)
  deployedBy                     String                  @db.VarChar(200)
  deployedAt                     DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt                      DateTime                @updatedAt @db.Timestamptz(3)
  decision                       BuilderDecision         @relation(fields: [decisionId], references: [id], onDelete: Restrict)
  deployedResourceVersion        ResourceVersion         @relation(fields: [deployedResourceVersionId], references: [id], onDelete: Restrict)
  sourcePublication              CatalogPublication?     @relation("DeploymentSourcePublication", fields: [sourcePublicationId], references: [id], onDelete: Restrict)
  configurationRevisions         ConfigurationRevision[]
  workspace                      Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  department                     Department?             @relation(fields: [departmentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@index([workspaceId, departmentId, status, deployedAt])
  @@index([sourcePublicationId, status])
  @@index([deployedResourceVersionId, status])
}

/// Append-only configuration overlay revision for an immutable deployed resource.
model ConfigurationRevision {
  id                 String                 @id @default(uuid()) @db.Uuid
  workspaceId        String                 @db.Uuid
  departmentId       String?                @db.Uuid
  deploymentId       String                 @db.Uuid
  revision           Int
  previousRevisionId String?                @unique @db.Uuid
  configuration      Json
  digest             String                 @db.VarChar(64)
  createdBy          String                 @db.VarChar(200)
  createdAt          DateTime               @default(now()) @db.Timestamptz(3)
  deployment         Deployment             @relation(fields: [deploymentId], references: [id], onDelete: Restrict)
  previousRevision   ConfigurationRevision? @relation("ConfigurationRevisionChain", fields: [previousRevisionId], references: [id], onDelete: Restrict)
  nextRevision       ConfigurationRevision? @relation("ConfigurationRevisionChain")
  workspace          Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  department         Department?            @relation(fields: [departmentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@unique([deploymentId, revision])
  @@index([workspaceId, departmentId, createdAt])
}

/// Materialized resource lineage. Extension drafts retain basePublicationId until materialization.
model ResourceLineage {
  id                      String                      @id @default(uuid()) @db.Uuid
  workspaceId             String                      @db.Uuid
  departmentId            String?                     @db.Uuid
  childResourceVersionId  String                      @db.Uuid
  parentResourceVersionId String                      @db.Uuid
  relationship            ResourceLineageRelationship
  ordinal                 Int?
  decisionId              String                      @db.Uuid
  createdBy               String                      @db.VarChar(200)
  createdAt               DateTime                    @default(now()) @db.Timestamptz(3)
  childResourceVersion    ResourceVersion             @relation("ResourceLineageChild", fields: [childResourceVersionId], references: [id], onDelete: Restrict)
  parentResourceVersion   ResourceVersion             @relation("ResourceLineageParent", fields: [parentResourceVersionId], references: [id], onDelete: Restrict)
  decision                BuilderDecision             @relation(fields: [decisionId], references: [id], onDelete: Restrict)
  workspace               Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  department              Department?                 @relation(fields: [departmentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@unique([childResourceVersionId, relationship, parentResourceVersionId])
  @@unique([childResourceVersionId, ordinal])
  @@index([workspaceId, departmentId, createdAt])
  @@index([parentResourceVersionId])
  @@index([decisionId])
}
