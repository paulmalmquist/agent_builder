model CertificationRun {
  id                          String                           @id @default(uuid()) @db.Uuid
  agentVersionId              String                           @db.Uuid
  subjectResourceVersionId    String?                          @db.Uuid
  comparisonResourceVersionId String?                          @db.Uuid
  familyId                    String                           @db.Uuid
  championVersionId           String?                          @db.Uuid
  kind                        CertificationRunKind
  originStatus                AgentStatus
  state                       CertificationRunState            @default(QUEUED)
  corpusVersionId             String                           @db.Uuid
  corpusVersion               Int
  gateConfigId                String                           @db.Uuid
  gateConfigVersion           Int
  corpusSnapshot              Json
  gateConfigSnapshot          Json
  subjectSnapshot             Json
  championSnapshot            Json?
  subjectManifestSnapshot     Json
  championManifestSnapshot    Json?
  subjectManifestHash         String                           @db.VarChar(128)
  championManifestHash        String?                          @db.VarChar(128)
  specRevision                Int
  generatorVersion            String                           @db.VarChar(80)
  executorKind                ExecutorKind                     @default(MANIFEST_FIXTURE)
  executorVersion             String                           @db.VarChar(80)
  evaluationMode              EvaluationMode                   @default(CORPUS_COVERAGE)
  progress                    Int                              @default(0)
  message                     String                           @default("Queued") @db.VarChar(500)
  totalCaseCount              Int                              @default(0)
  passedCaseCount             Int                              @default(0)
  failedCaseCount             Int                              @default(0)
  verdict                     CertificationVerdict?
  error                       Json?
  requestedBy                 String                           @db.VarChar(200)
  startedBy                   String?                          @db.VarChar(200)
  requestedAt                 DateTime                         @default(now()) @db.Timestamptz(3)
  startedAt                   DateTime?                        @db.Timestamptz(3)
  finishedAt                  DateTime?                        @db.Timestamptz(3)
  promotionExpiresAt          DateTime?                        @db.Timestamptz(3)
  nightlyScheduleKey          String?                          @db.VarChar(160)
  isPromotionEvidence         Boolean                          @default(false)
  resultsAvailability         CertificationResultsAvailability @default(FULL)
  caseResultsPrunedAt         DateTime?                        @db.Timestamptz(3)
