}

model Workspace {
  id        String   @id @db.Uuid
  slug      String   @unique @db.VarChar(120)
  name      String   @db.VarChar(160)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  departments             Department[]
  agentFamilies           AgentFamily[]
  knowledgeSources        KnowledgeSource[]
  certificationGateConfig CertificationGateConfig[]
  evalCases               EvalCase[]
  evalCorpusVersions      EvalCorpusVersion[]
  specInterpretations     SpecInterpretation[]
  auditEvents             AuditEvent[]
  resourceFamilies        ResourceFamily[]
  releaseBundles          ReleaseBundle[]
  productionChannels      ProductionChannel[]
  authorityGrants         AuthorityGrant[]
  executionRuns           ExecutionRun[]
  metricSamples           MetricSample[]
  automationSchedules     AutomationSchedule[]
  observations            Observation[]
  platformEvents          PlatformEvent[]
  attentionCursors        AttentionCursor[]
  digestSnapshots         DigestSnapshot[]
  digestDeliveryAttempts  DigestDeliveryAttempt[]
  executionRunEvents      ExecutionRunEvent[]
  releaseDeclineDecisions ReleaseDeclineDecision[]
  attentionResolutions    AttentionResolution[]
  pluginInstallations     PluginInstallation[]
  pluginInvocations       PluginInvocation[]
  pluginCallPlans         RunPluginCallPlan[]
  capabilityProfiles      CapabilityProfile[]
  catalogPublications     CatalogPublication[]
  catalogIndexOutbox      CatalogIndexOutbox[]
  catalogIndexRecords     CatalogIndexRecord[]
  builderIntakes          BuilderIntake[]
  builderDecisions        BuilderDecision[]
  builderDrafts           BuilderDraft[]
  deployments             Deployment[]
  configurationRevisions  ConfigurationRevision[]
  resourceLineages        ResourceLineage[]
  principals              Principal[]
  externalIdentities      ExternalIdentity[]
  roleBindings            RoleBinding[]
  servicePrincipals       ServicePrincipal[]
  projectInstances        ProjectInstance[]
}

model Department {
  id          String   @id @db.Uuid
  workspaceId String   @db.Uuid
  slug        String   @db.VarChar(120)
  name        String   @db.VarChar(160)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  workspace               Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  agentFamilies           AgentFamily[]
  knowledgeSources        KnowledgeSource[]
  certificationGateConfig CertificationGateConfig[]
  evalCases               EvalCase[]
  evalCorpusVersions      EvalCorpusVersion[]
  specInterpretations     SpecInterpretation[]
  auditEvents             AuditEvent[]
  resourceFamilies        ResourceFamily[]
  releaseBundles          ReleaseBundle[]
  productionChannels      ProductionChannel[]
  authorityGrants         AuthorityGrant[]
  executionRuns           ExecutionRun[]
  metricSamples           MetricSample[]
  automationSchedules     AutomationSchedule[]
  observations            Observation[]
  platformEvents          PlatformEvent[]
  attentionCursors        AttentionCursor[]
  digestSnapshots         DigestSnapshot[]
  digestDeliveryAttempts  DigestDeliveryAttempt[]
  executionRunEvents      ExecutionRunEvent[]
  releaseDeclineDecisions ReleaseDeclineDecision[]
  attentionResolutions    AttentionResolution[]
  pluginInstallations     PluginInstallation[]
  pluginInvocations       PluginInvocation[]
  pluginCallPlans         RunPluginCallPlan[]
  capabilityProfiles      CapabilityProfile[]
  catalogPublications     CatalogPublication[]
  catalogIndexOutbox      CatalogIndexOutbox[]
  catalogIndexRecords     CatalogIndexRecord[]
  builderIntakes          BuilderIntake[]
  builderDecisions        BuilderDecision[]
  builderDrafts           BuilderDraft[]
  deployments             Deployment[]
  configurationRevisions  ConfigurationRevision[]
  resourceLineages        ResourceLineage[]
  roleBindings            RoleBinding[]
  projectInstances        ProjectInstance[]
  principals              Principal[]

  @@unique([workspaceId, slug])
  @@unique([id, workspaceId])
  @@index([workspaceId, name])
}

/// A workspace-owned actor. Human and service identities share one authorization subject.
model Principal {
  id               String        @id @default(uuid()) @db.Uuid
  workspaceId      String        @db.Uuid
  homeDepartmentId String?       @db.Uuid
  actorId          String        @db.VarChar(200)
  kind             PrincipalKind
  displayName      String        @db.VarChar(200)
  active           Boolean       @default(true)
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)

  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  homeDepartment     Department?        @relation(fields: [homeDepartmentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  externalIdentities ExternalIdentity[]
  roleBindings       RoleBinding[]
  servicePrincipal   ServicePrincipal?

  @@unique([workspaceId, actorId])
  @@unique([id, workspaceId])
  @@index([workspaceId, active, kind])
  @@index([workspaceId, homeDepartmentId, active])
}

/// Verified issuer/subject mappings. Tokens and claims are never persisted here.
model ExternalIdentity {
  id          String                   @id @default(uuid()) @db.Uuid
  workspaceId String                   @db.Uuid
  principalId String                   @db.Uuid
  provider    ExternalIdentityProvider
  issuer      String                   @db.VarChar(500)
  subject     String                   @db.VarChar(500)
  createdAt   DateTime                 @default(now()) @db.Timestamptz(3)
  lastSeenAt  DateTime?                @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  principal Principal @relation(fields: [principalId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@unique([workspaceId, issuer, subject])
  @@index([principalId, workspaceId])
}

/// Role assignment scoped to a workspace, department, or project instance.
/// scopeKey is canonicalized by the service and closes PostgreSQL nullable-unique gaps.
model RoleBinding {
  id                String       @id @default(uuid()) @db.Uuid
  workspaceId       String       @db.Uuid
  principalId       String       @db.Uuid
  departmentId      String?      @db.Uuid
  projectInstanceId String?      @db.Uuid
  role              PlatformRole
  scopeKey          String       @db.VarChar(220)
  grantedBy         String       @db.VarChar(200)
  grantedAt         DateTime     @default(now()) @db.Timestamptz(3)
  revokedAt         DateTime?    @db.Timestamptz(3)

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  principal       Principal        @relation(fields: [principalId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  department      Department?      @relation(fields: [departmentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  projectInstance ProjectInstance? @relation(fields: [projectInstanceId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@unique([workspaceId, principalId, role, scopeKey])
  @@index([workspaceId, departmentId, role, revokedAt])
  @@index([projectInstanceId, role, revokedAt])
}

/// Thin machine identity metadata. credentialRef is an opaque secret-manager reference.
model ServicePrincipal {
  id            String                @id @default(uuid()) @db.Uuid
  workspaceId   String                @db.Uuid
  principalId   String                @unique @db.Uuid
  slug          String                @db.VarChar(120)
  purpose       String                @db.VarChar(500)
  credentialRef String?               @db.VarChar(500)
  state         ServicePrincipalState @default(ACTIVE)
  createdAt     DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime              @updatedAt @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  principal Principal @relation(fields: [principalId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@unique([workspaceId, slug])
  @@unique([principalId, workspaceId])
  @@index([workspaceId, state])
}

/// A project overlay instance. This is the representative FORCE-RLS protected slice.
model ProjectInstance {
  id           String               @id @default(uuid()) @db.Uuid
  workspaceId  String               @db.Uuid
  departmentId String?              @db.Uuid
  slug         String               @db.VarChar(120)
  name         String               @db.VarChar(200)
  state        ProjectInstanceState @default(ACTIVE)
  createdBy    String               @db.VarChar(200)
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @db.Timestamptz(3)

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  department   Department?   @relation(fields: [departmentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  roleBindings RoleBinding[]

  @@unique([workspaceId, slug])
  @@unique([id, workspaceId])
  @@index([workspaceId, departmentId, state])
}

model AgentFamily {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @db.Uuid
  departmentId    String?  @db.Uuid
  slug            String   @db.VarChar(160)
  name            String   @db.VarChar(120)
  department      String   @db.VarChar(120)
  owner           String   @db.VarChar(160)
  championAgentId String?  @unique @db.Uuid
  createdBy       String   @db.VarChar(200)
  updatedBy       String   @db.VarChar(200)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  championAgent      Agent?              @relation("FamilyChampion", fields: [championAgentId], references: [id], onDelete: SetNull)
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  scopedDepartment   Department?         @relation(fields: [departmentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  versions           Agent[]             @relation("FamilyVersions")
  certificationRuns  CertificationRun[]
  promotionDecisions PromotionDecision[]

  @@unique([workspaceId, slug])
  @@index([department])
  @@index([workspaceId, departmentId])
}

model Agent {
  id                   String              @id @default(uuid()) @db.Uuid
  familyId             String              @db.Uuid
  slug                 String              @db.VarChar(160)
  versionNumber        Int
  predecessorAgentId   String?             @db.Uuid
  derivationMode       AgentDerivationMode @default(NEW)
  name                 String              @db.VarChar(120)
  department           String              @db.VarChar(120)
  purpose              String              @db.Text
  owner                String              @db.VarChar(160)
  status               AgentStatus         @default(DRAFT)
  capabilities         Json                @default("[]")
  manifest             Json?
  manifestHash         String?             @db.VarChar(128)
  certificationHealth  CertificationHealth @default(NOT_CERTIFIED)
  degradedAt           DateTime?           @db.Timestamptz(3)
  degradationReason    String?             @db.Text
  activationDecisionId String?             @unique @db.Uuid
  legacyActivation     Boolean             @default(false)
  retirementReason     RetirementReason?
  retiredAt            DateTime?           @db.Timestamptz(3)
  retiredBy            String?             @db.VarChar(200)
  retirementRationale  String?             @db.Text
  successorAgentId     String?             @db.Uuid
  createdBy            String              @db.VarChar(200)
  updatedBy            String              @db.VarChar(200)
  createdAt            DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime            @updatedAt @db.Timestamptz(3)

  family                  AgentFamily            @relation("FamilyVersions", fields: [familyId], references: [id], onDelete: Restrict)
  championForFamily       AgentFamily?           @relation("FamilyChampion")
  predecessorAgent        Agent?                 @relation("AgentPredecessor", fields: [predecessorAgentId], references: [id], onDelete: SetNull)
  successorVersions       Agent[]                @relation("AgentPredecessor")
  successorAgent          Agent?                 @relation("RetirementSuccessor", fields: [successorAgentId], references: [id], onDelete: SetNull)
  supersededVersions      Agent[]                @relation("RetirementSuccessor")
  activationDecision      PromotionDecision?     @relation("ActivationDecision", fields: [activationDecisionId], references: [id], onDelete: SetNull)
  spec                    AgentSpec?             @relation("GeneratedAgent")
  basedSpecs              AgentSpec[]            @relation("BaseAgent")
  generationJobs          GenerationJob[]
  guardrails              Guardrail[]
  evaluationTests         EvaluationTest[]
  knowledgeSources        AgentKnowledgeSource[]
  certificationRuns       CertificationRun[]     @relation("CertificationSubject")
  championComparisonRuns  CertificationRun[]     @relation("CertificationChampion")
  promotionDecisions      PromotionDecision[]    @relation("PromotedVersion")
  priorChampionDecisions  PromotionDecision[]    @relation("PriorChampionVersion")
  platformResourceVersion ResourceVersion?       @relation("LegacyAgentResource")

  @@unique([familyId, versionNumber])
  @@unique([familyId, slug])
  @@index([familyId, status])
  @@index([status])
  @@index([department])
  @@index([predecessorAgentId])
}

model AgentSpec {
  id                  String                    @id @default(uuid()) @db.Uuid
  agentId             String                    @unique @db.Uuid
  baseAgentId         String?                   @db.Uuid
  derivationMode      AgentDerivationMode       @default(NEW)
  interpretationId    String?                   @unique @db.Uuid
  unconfirmedPrefill  Json?
  status              SpecStatus                @default(DRAFT)
  revision            Int                       @default(1)
  outcomes            Json?
  knowledge           Json?
  guardrails          Json?
  outputs             Json?
  createdBy           String                    @db.VarChar(200)
  updatedBy           String                    @db.VarChar(200)
  createdAt           DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                  @updatedAt @db.Timestamptz(3)
  agent               Agent                     @relation("GeneratedAgent", fields: [agentId], references: [id], onDelete: Cascade)
  baseAgent           Agent?                    @relation("BaseAgent", fields: [baseAgentId], references: [id], onDelete: SetNull)
  interpretation      SpecInterpretation?       @relation("AttachedInterpretation", fields: [interpretationId], references: [id], onDelete: SetNull)
  generationJobs      GenerationJob[]
  confirmations       SpecSectionConfirmation[] @relation("ConfirmedSpec")
  sourceConfirmations SpecSectionConfirmation[] @relation("ConfirmationSourceSpec")

  @@index([status])
  @@index([baseAgentId])
  @@index([derivationMode])
}

model KnowledgeSource {
  id               String                 @db.VarChar(100)
  workspaceId      String                 @db.Uuid
  departmentId     String?                @db.Uuid
  role             SourceRole
  provider         SourceProvider
  displayName      String                 @db.VarChar(160)
