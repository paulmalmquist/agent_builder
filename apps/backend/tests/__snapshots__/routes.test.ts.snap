                              "message",
                              "recommendedAction",
                            ],
                            "type": "object",
                          },
                          "type": "array",
                        },
                        "eligible": {
                          "type": "boolean",
                        },
                        "freshUntil": {
                          "format": "date-time",
                          "nullable": true,
                          "type": "string",
                        },
                      },
