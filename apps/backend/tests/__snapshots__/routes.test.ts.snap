  "info": {
    "description": "Reuse-first governed agent specification, certification, and promotion API.",
    "title": "Relativity Agent Builder API",
    "version": "0.3.0",
  },
  "openapi": "3.0.3",
  "paths": {
    "/agents": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "query",
            "required": false,
            "schema": {
              "maxLength": 2000,
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "department",
            "required": false,
            "schema": {
              "maxLength": 120,
              "minLength": 1,
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "enum": [
                "draft",
                "generating",
                "ready",
                "shadow",
                "certifying",
                "certified",
                "rejected",
                "active",
                "failed",
                "retired",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "provider",
            "required": false,
            "schema": {
              "enum": [
                "bigquery",
                "confluence",
                "jira",
                "email",
                "slack",
                "interstellar",
                "fixture",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "familyId",
            "required": false,
            "schema": {
              "format": "uuid",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "includeRetired",
            "required": false,
            "schema": {
              "enum": [
                "true",
                "false",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 30,
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
            },
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "maxLength": 500,
              "minLength": 1,
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "properties": {
                        "items": {
                          "items": {
                            "properties": {
                              "capabilities": {
                                "items": {
                                  "type": "string",
                                },
                                "type": "array",
                              },
                              "certificationHealth": {
                                "enum": [
                                  "not_certified",
                                  "current",
                                  "degraded",
                                ],
                                "type": "string",
                              },
                              "createdAt": {
                                "format": "date-time",
                                "type": "string",
                              },
                              "degradationReason": {
                                "nullable": true,
                                "type": "string",
                              },
                              "degradedAt": {
                                "format": "date-time",
                                "nullable": true,
                                "type": "string",
                              },
                              "department": {
                                "minLength": 2,
                                "type": "string",
                              },
                              "derivationMode": {
                                "enum": [
                                  "new",
                                  "configure",
                                  "extend",
                                ],
                                "type": "string",
                              },
                              "familyId": {
                                "format": "uuid",
                                "type": "string",
                              },
                              "familySlug": {
                                "maxLength": 160,
                                "minLength": 1,
                                "type": "string",
                              },
                              "gaps": {
                                "items": {
                                  "type": "string",
                                },
                                "type": "array",
                              },
                              "id": {
                                "format": "uuid",
                                "type": "string",
                              },
                              "isChampion": {
                                "type": "boolean",
                              },
                              "manifest": {
                                "nullable": true,
                                "properties": {
                                  "agentId": {
                                    "format": "uuid",
                                    "type": "string",
                                  },
                                  "department": {
                                    "minLength": 2,
                                    "type": "string",
                                  },
                                  "evaluations": {
                                    "items": {
