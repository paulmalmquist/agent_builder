                            "type": "string",
                          },
                          "name": {
                            "type": "string",
                          },
                          "pluginVersionId": {
                            "format": "uuid",
                            "type": "string",
                          },
                          "secretSlots": {
                            "items": {
                              "additionalProperties": false,
