    "/v1/release-evaluations": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "releaseId": {
                    "format": "uuid",
                    "type": "string",
                  },
                  "requestedMode": {
                    "default": "contract_validation",
                    "enum": [
                      "contract_validation",
                      "semantic_execution",
                    ],
                    "type": "string",
                  },
                  "suiteVersionId": {
                    "format": "uuid",
                    "type": "string",
                  },
                },
                "required": [
                  "releaseId",
                  "suiteVersionId",
                ],
                "type": "object",
              },
            },
          },
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "corpusVersion": {
                      "exclusiveMinimum": true,
                      "minimum": 0,
                      "type": "integer",
                    },
                    "createdAt": {
                      "format": "date-time",
                      "type": "string",
                    },
                    "disclaimer": {
                      "enum": [
                        "Deterministic contract evidence validates declared fixtures and release composition; it does not measure semantic model quality.",
                      ],
                      "type": "string",
                    },
                    "evaluationMode": {
                      "enum": [
                        "contract_validation",
                      ],
                      "type": "string",
                    },
                    "evidence": {
                      "properties": {
                        "assertionCount": {
                          "minimum": 0,
                          "type": "integer",
                        },
                        "certifiedResourceIds": {
                          "items": {
                            "format": "uuid",
                            "type": "string",
                          },
                          "maxItems": 1000,
                          "type": "array",
                        },
                        "dependencyClosureComplete": {
                          "type": "boolean",
                        },
                        "gateResults": {
                          "items": {
                            "properties": {
                              "category": {
                                "enum": [
                                  "contract",
                                  "cost",
                                  "latency",
                                  "outcome_history",
                                ],
                                "type": "string",
                              },
                              "detail": {
                                "maxLength": 500,
                                "minLength": 1,
                                "type": "string",
                              },
                              "evidenceSource": {
                                "enum": [
                                  "manifest_declaration",
                                  "execution_history",
                                ],
                                "type": "string",
                              },
                              "key": {
                                "enum": [
                                  "dependency_closure",
                                  "schema_conformance",
                                  "citation_coverage",
                                  "unauthorized_actions",
                                  "mean_cost_usd",
                                  "p95_latency_ms",
                                  "mean_outcome_quality",
                                ],
                                "type": "string",
                              },
                              "measuredValue": {
                                "nullable": true,
                                "type": "number",
                              },
                              "operator": {
                                "enum": [
                                  "gte",
                                  "lte",
                                  "eq",
                                ],
                                "type": "string",
                              },
                              "sampleSize": {
                                "minimum": 0,
                                "type": "integer",
                              },
                              "status": {
                                "enum": [
                                  "passed",
                                  "failed",
                                  "not_applicable",
                                ],
                                "type": "string",
                              },
                              "threshold": {
                                "type": "number",
                              },
                            },
                            "required": [
                              "key",
                              "category",
                              "operator",
                              "threshold",
                              "measuredValue",
                              "status",
                              "sampleSize",
                              "evidenceSource",
                              "detail",
                            ],
                            "type": "object",
                          },
                          "maxItems": 7,
                          "minItems": 3,
                          "type": "array",
                        },
                        "historyRunIds": {
                          "items": {
                            "format": "uuid",
                            "type": "string",
                          },
                          "maxItems": 10000,
                          "type": "array",
                        },
                        "historySnapshotDigest": {
                          "pattern": "^[a-f0-9]{64}$",
                          "type": "string",
                        },
                        "schemaVersion": {
                          "enum": [
                            1,
                          ],
                          "type": "number",
                        },
                        "subjectDigest": {
                          "type": "string",
                        },
                        "subjectPresent": {
                          "type": "boolean",
                        },
                        "suiteCaseCount": {
                          "minimum": 0,
                          "type": "integer",
                        },
                      },
                      "required": [
                        "schemaVersion",
                        "historySnapshotDigest",
                        "historyRunIds",
                        "suiteCaseCount",
                        "assertionCount",
                        "subjectPresent",
                        "subjectDigest",
                        "gateResults",
                      ],
                      "type": "object",
                    },
                    "executorKind": {
                      "enum": [
                        "deterministic_contract",
                      ],
                      "type": "string",
                    },
                    "executorVersion": {
                      "pattern": "^\\d+\\.\\d+\\.\\d+$",
                      "type": "string",
                    },
                    "finishedAt": {
                      "format": "date-time",
                      "type": "string",
                    },
                    "gateResults": {
                      "items": {
                        "properties": {
                          "category": {
                            "enum": [
                              "contract",
                              "cost",
                              "latency",
                              "outcome_history",
                            ],
                            "type": "string",
                          },
                          "detail": {
                            "maxLength": 500,
                            "minLength": 1,
                            "type": "string",
                          },
                          "evidenceSource": {
                            "enum": [
                              "manifest_declaration",
                              "execution_history",
                            ],
                            "type": "string",
                          },
                          "key": {
                            "enum": [
                              "dependency_closure",
                              "schema_conformance",
                              "citation_coverage",
                              "unauthorized_actions",
                              "mean_cost_usd",
                              "p95_latency_ms",
                              "mean_outcome_quality",
                            ],
                            "type": "string",
                          },
                          "measuredValue": {
                            "nullable": true,
                            "type": "number",
                          },
                          "operator": {
                            "enum": [
                              "gte",
                              "lte",
                              "eq",
                            ],
                            "type": "string",
                          },
                          "sampleSize": {
                            "minimum": 0,
                            "type": "integer",
                          },
                          "status": {
                            "enum": [
                              "passed",
                              "failed",
                              "not_applicable",
                            ],
                            "type": "string",
                          },
                          "threshold": {
                            "type": "number",
                          },
                        },
                        "required": [
                          "key",
                          "category",
                          "operator",
                          "threshold",
                          "measuredValue",
                          "status",
                          "sampleSize",
                          "evidenceSource",
                          "detail",
                        ],
                        "type": "object",
                      },
                      "maxItems": 7,
                      "minItems": 3,
                      "type": "array",
                    },
                    "gateScores": {
                      "properties": {
                        "citationCoverage": {
                          "maximum": 1,
                          "minimum": 0,
                          "type": "number",
                        },
                        "schemaConformance": {
                          "maximum": 1,
                          "minimum": 0,
                          "type": "number",
                        },
                        "unauthorizedActions": {
                          "minimum": 0,
                          "type": "integer",
                        },
                      },
                      "required": [
                        "schemaConformance",
                        "citationCoverage",
                        "unauthorizedActions",
                      ],
                      "type": "object",
                    },
                    "historySnapshotDigest": {
                      "pattern": "^[a-f0-9]{64}$",
                      "type": "string",
                    },
                    "id": {
                      "format": "uuid",
                      "type": "string",
                    },
                    "releaseDigest": {
                      "pattern": "^[a-f0-9]{64}$",
                      "type": "string",
                    },
                    "releaseId": {
                      "format": "uuid",
                      "type": "string",
                    },
                    "requestedBy": {
                      "type": "string",
                    },
                    "results": {
                      "items": {
                        "properties": {
                          "assertions": {
                            "items": {
                              "properties": {
                                "detail": {
                                  "maxLength": 500,
                                  "type": "string",
                                },
                                "key": {
                                  "enum": [
                                    "output_schema_valid",
                                    "schedule_risk_present",
                                    "citations_resolve_to_supplied_calendar_items",
                                    "no_attempted_actions",
                                  ],
                                  "type": "string",
                                },
                                "passed": {
                                  "type": "boolean",
                                },
                              },
                              "required": [
                                "key",
                                "passed",
                                "detail",
                              ],
                              "type": "object",
                            },
                            "type": "array",
                          },
                          "caseKey": {
                            "type": "string",
                          },
                          "passed": {
                            "type": "boolean",
                          },
                        },
                        "required": [
                          "caseKey",
                          "assertions",
                          "passed",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                    "suiteDigest": {
                      "pattern": "^[a-f0-9]{64}$",
                      "type": "string",
                    },
                    "suiteVersionId": {
                      "format": "uuid",
                      "type": "string",
                    },
                    "verdict": {
                      "enum": [
                        "passed",
                        "failed",
                        "error",
                      ],
                      "type": "string",
                    },
                  },
                  "required": [
                    "id",
                    "releaseId",
                    "releaseDigest",
                    "suiteVersionId",
                    "suiteDigest",
                    "executorKind",
                    "executorVersion",
                    "evaluationMode",
                    "historySnapshotDigest",
                    "corpusVersion",
                    "verdict",
                    "results",
                    "gateScores",
                    "gateResults",
                    "disclaimer",
                    "evidence",
                    "requestedBy",
                    "createdAt",
                    "finishedAt",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Immutable deterministic release evidence",
          },
