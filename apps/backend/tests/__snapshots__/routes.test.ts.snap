                          "costThisWeekUsd": {
                            "minimum": 0,
                            "type": "number",
                          },
                          "digest": {
                            "pattern": "^[a-f0-9]{64}$",
                            "type": "string",
                          },
                          "executionPlacement": {
                            "enum": [
                              "control_plane",
                              "workstation",
                            ],
                            "type": "string",
                          },
                          "familyId": {
                            "format": "uuid",
                            "type": "string",
                          },
                          "healthStatus": {
                            "enum": [
                              "unknown",
                              "healthy",
                              "degraded",
                              "unavailable",
