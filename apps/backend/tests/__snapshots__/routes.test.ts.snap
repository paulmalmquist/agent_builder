                "schema": {
                  "properties": {
                    "champion": {
                      "nullable": true,
                      "properties": {
                        "agentVersionId": {
                          "format": "uuid",
                          "type": "string",
                        },
                        "lifecycleStatus": {
                          "enum": [
                            "draft",
                            "generating",
                            "ready",
                            "shadow",
                            "certifying",
                            "certified",
                            "rejected",
                            "active",
                            "failed",
                            "retired",
                          ],
                          "type": "string",
                        },
                        "manifestHash": {
                          "maxLength": 128,
                          "minLength": 1,
                          "type": "string",
                        },
                        "name": {
                          "maxLength": 120,
                          "minLength": 2,
                          "type": "string",
                        },
                        "versionNumber": {
                          "exclusiveMinimum": true,
                          "minimum": 0,
                          "type": "integer",
                        },
                      },
                      "required": [
                        "agentVersionId",
                        "name",
                        "versionNumber",
                        "lifecycleStatus",
                        "manifestHash",
                      ],
                      "type": "object",
