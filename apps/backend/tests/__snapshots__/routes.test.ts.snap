  "info": {
    "description": "Governed resource, execution, agent specification, and certification API.",
    "title": "Paul OS API",
    "version": "0.3.0",
  },
  "openapi": "3.0.3",
  "paths": {
    "/agents": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "query",
            "required": false,
            "schema": {
              "maxLength": 2000,
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "department",
            "required": false,
            "schema": {
              "maxLength": 120,
              "minLength": 1,
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "enum": [
                "draft",
                "generating",
                "ready",
                "shadow",
                "certifying",
                "certified",
                "rejected",
                "active",
                "failed",
                "retired",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "provider",
            "required": false,
            "schema": {
              "enum": [
                "bigquery",
                "confluence",
                "jira",
                "email",
                "slack",
                "telemetry",
                "fixture",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "familyId",
            "required": false,
            "schema": {
              "format": "uuid",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "includeRetired",
            "required": false,
            "schema": {
              "enum": [
                "true",
                "false",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 30,
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
            },
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "maxLength": 500,
              "minLength": 1,
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "properties": {
                        "items": {
                          "items": {
                            "properties": {
                              "capabilities": {
                                "items": {
                                  "type": "string",
                                },
                                "type": "array",
                              },
                              "certificationHealth": {
                                "enum": [
                                  "not_certified",
                                  "current",
                                  "degraded",
                                ],
                                "type": "string",
                              },
                              "createdAt": {
                                "format": "date-time",
                                "type": "string",
                              },
                              "degradationReason": {
                                "nullable": true,
                                "type": "string",
                              },
                              "degradedAt": {
                                "format": "date-time",
                                "nullable": true,
                                "type": "string",
                              },
                              "department": {
                                "minLength": 2,
                                "type": "string",
                              },
                              "derivationMode": {
                                "enum": [
                                  "new",
                                  "configure",
                                  "extend",
                                ],
                                "type": "string",
                              },
                              "familyId": {
                                "format": "uuid",
                                "type": "string",
                              },
                              "familySlug": {
                                "maxLength": 160,
                                "minLength": 1,
                                "type": "string",
                              },
                              "gaps": {
                                "items": {
                                  "type": "string",
                                },
                                "type": "array",
                              },
                              "id": {
                                "format": "uuid",
                                "type": "string",
                              },
                              "isChampion": {
                                "type": "boolean",
                              },
                              "manifest": {
                                "nullable": true,
                                "properties": {
                                  "agentId": {
                                    "format": "uuid",
                                    "type": "string",
                                  },
                                  "department": {
                                    "minLength": 2,
                                    "type": "string",
                                  },
                                  "evaluations": {
                                    "items": {
                                      "properties": {
                                        "expectedResult": {
                                          "additionalProperties": true,
                                          "description": "Arbitrary JSON value.",
                                          "type": "object",
                                        },
                                        "input": {
                                          "additionalProperties": true,
                                          "description": "Arbitrary JSON value.",
                                          "type": "object",
                                        },
                                        "name": {
                                          "minLength": 1,
                                          "type": "string",
                                        },
                                      },
                                      "required": [
                                        "name",
                                        "input",
                                        "expectedResult",
                                      ],
                                      "type": "object",
                                    },
                                    "type": "array",
                                  },
                                  "generatedAt": {
                                    "format": "date-time",
                                    "type": "string",
                                  },
                                  "generatorVersion": {
                                    "minLength": 1,
                                    "type": "string",
                                  },
                                  "guardrails": {
                                    "properties": {
                                      "approvalRequirements": {
                                        "items": {
                                          "maxLength": 500,
                                          "minLength": 2,
                                          "type": "string",
                                        },
                                        "maxItems": 30,
                                        "type": "array",
                                      },
                                      "failClosedConditions": {
                                        "items": {
                                          "maxLength": 500,
                                          "minLength": 2,
                                          "type": "string",
                                        },
                                        "maxItems": 30,
                                        "minItems": 1,
                                        "type": "array",
                                      },
                                      "prohibitedActions": {
                                        "items": {
                                          "maxLength": 500,
                                          "minLength": 2,
                                          "type": "string",
                                        },
                                        "maxItems": 30,
                                        "type": "array",
                                      },
                                      "responseRequirements": {
                                        "properties": {
                                          "citations": {
                                            "type": "boolean",
                                          },
                                          "confidence": {
                                            "type": "boolean",
                                          },
                                          "unresolvedConflicts": {
                                            "type": "boolean",
                                          },
                                        },
                                        "required": [
                                          "citations",
                                          "confidence",
                                          "unresolvedConflicts",
                                        ],
                                        "type": "object",
                                      },
                                      "workflowStages": {
                                        "items": {
                                          "maxLength": 300,
                                          "minLength": 2,
                                          "type": "string",
                                        },
                                        "maxItems": 30,
                                        "minItems": 1,
                                        "type": "array",
                                      },
                                    },
                                    "required": [
                                      "workflowStages",
                                      "prohibitedActions",
                                      "approvalRequirements",
                                      "failClosedConditions",
                                      "responseRequirements",
                                    ],
                                    "type": "object",
                                  },
                                  "knowledgeSourceIds": {
                                    "items": {
                                      "minLength": 1,
                                      "type": "string",
                                    },
                                    "type": "array",
                                  },
                                  "name": {
                                    "minLength": 2,
                                    "type": "string",
                                  },
                                  "outputSchema": {
                                    "additionalProperties": true,
                                    "type": "object",
                                  },
                                  "outputType": {
                                    "enum": [
                                      "investigation_report",
                                      "decision_brief",
                                      "dashboard_update",
                                      "ticket",
                                      "email_draft",
                                      "api_response",
                                      "structured_record",
                                    ],
                                    "type": "string",
                                  },
                                  "purpose": {
                                    "minLength": 10,
                                    "type": "string",
                                  },
                                  "specRevision": {
                                    "exclusiveMinimum": true,
                                    "minimum": 0,
                                    "type": "integer",
                                  },
                                  "version": {
                                    "minLength": 1,
                                    "type": "string",
                                  },
                                  "workflow": {
                                    "items": {
                                      "minLength": 2,
                                      "type": "string",
                                    },
                                    "minItems": 1,
                                    "type": "array",
                                  },
                                },
                                "required": [
                                  "agentId",
                                  "name",
                                  "department",
                                  "purpose",
                                  "version",
                                  "specRevision",
                                  "generatorVersion",
                                  "workflow",
                                  "knowledgeSourceIds",
                                  "guardrails",
                                  "outputType",
                                  "outputSchema",
                                  "evaluations",
