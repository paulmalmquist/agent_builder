                    "gates": {
                      "items": {
                        "properties": {
                          "challengerScore": {
                            "nullable": true,
                            "type": "number",
                          },
                          "championScore": {
                            "nullable": true,
                            "type": "number",
                          },
                          "details": {
                            "additionalProperties": true,
                            "type": "object",
                          },
                          "gate": {
                            "enum": [
                              "factual_accuracy",
                              "citation_coverage",
                              "unauthorized_actions",
                              "champion_regression",
                            ],
                            "type": "string",
                          },
                          "measuredValue": {
                            "nullable": true,
                            "type": "number",
                          },
                          "operator": {
                            "enum": [
                              "gte",
                              "lte",
                              "eq",
                            ],
                            "type": "string",
                          },
                          "status": {
                            "enum": [
                              "passed",
                              "failed",
                              "not_applicable",
                            ],
                            "type": "string",
                          },
                          "threshold": {
                            "type": "number",
                          },
                        },
                        "required": [
                          "gate",
                          "operator",
                          "threshold",
                          "championScore",
                          "challengerScore",
                          "measuredValue",
                          "status",
                          "details",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                    "promotionEligibility": {
                      "properties": {
                        "blockers": {
                          "items": {
                            "properties": {
                              "code": {
                                "enum": [
                                  "run_stale",
                                  "corpus_superseded",
                                  "gate_config_superseded",
                                  "champion_changed",
                                  "manifest_changed",
                                  "results_pruned",
                                  "run_not_passed",
