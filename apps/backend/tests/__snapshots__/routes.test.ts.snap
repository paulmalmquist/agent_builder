      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "authorityGrantId": {
                    "format": "uuid",
                    "nullable": true,
                    "type": "string",
                  },
                  "developmentDraft": {
                    "default": false,
                    "type": "boolean",
                  },
                  "idempotencyKey": {
                    "maxLength": 200,
                    "minLength": 8,
                    "type": "string",
                  },
                  "input": {
                    "additionalProperties": true,
                    "type": "object",
                  },
                  "maxEstimatedCostUsd": {
                    "maximum": 100000,
                    "minimum": 0,
                    "type": "number",
                  },
                  "maxInputTokens": {
                    "default": 8000,
                    "maximum": 1000000,
                    "minimum": 1,
                    "type": "integer",
                  },
                  "maxOutputTokens": {
                    "default": 2000,
                    "maximum": 1000000,
                    "minimum": 1,
                    "type": "integer",
                  },
                  "releaseId": {
                    "format": "uuid",
                    "type": "string",
                  },
                },
                "required": [
                  "releaseId",
                  "input",
                  "maxEstimatedCostUsd",
                  "idempotencyKey",
                ],
                "type": "object",
              },
            },
          },
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "actualCostUsd": {
                      "minimum": 0,
                      "nullable": true,
                      "type": "number",
