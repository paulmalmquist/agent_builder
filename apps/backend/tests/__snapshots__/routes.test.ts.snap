                                  "type": "string",
                                },
                                "description": {
                                  "type": "string",
                                },
                                "effect": {
                                  "enum": [
                                    "read",
                                    "write",
                                    "destructive",
                                  ],
                                  "type": "string",
                                },
                                "limits": {
                                  "additionalProperties": false,
                                  "properties": {
                                    "maxEstimatedCostUsd": {
                                      "maximum": 100000,
                                      "minimum": 0,
                                      "type": "number",
                                    },
                                    "maxInvocationsPerRun": {
                                      "maximum": 10000,
                                      "minimum": 1,
                                      "type": "integer",
