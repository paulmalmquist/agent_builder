                    },
                    "revision": {
                      "exclusiveMinimum": true,
                      "minimum": 0,
                      "type": "integer",
                    },
                    "subjectKind": {
                      "enum": [
                        "agent",
                        "skill",
                      ],
                      "type": "string",
