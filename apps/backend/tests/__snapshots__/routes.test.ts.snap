                      "type": "object",
                    },
                    "catalogVisibility": {
                      "enum": [
                        "private",
                        "department",
                        "organization",
                      ],
                      "type": "string",
                    },
                    "department": {
                      "maxLength": 160,
                      "minLength": 2,
                      "type": "string",
                    },
                    "id": {
                      "format": "uuid",
                      "type": "string",
                    },
                    "name": {
                      "maxLength": 160,
                      "minLength": 2,
                      "type": "string",
                    },
