                              "measuredRuns",
                              "rate",
                            ],
                            "type": "object",
                          },
                          "trustChip": {
                            "additionalProperties": false,
                            "properties": {
                              "certificationState": {
                                "enum": [
                                  "certified",
                                ],
                                "type": "string",
                              },
                              "corpusSize": {
                                "exclusiveMinimum": true,
                                "minimum": 0,
                                "type": "integer",
                              },
                              "gatesPassed": {
                                "exclusiveMinimum": true,
                                "minimum": 0,
                                "type": "integer",
                              },
                              "gatesTotal": {
                                "exclusiveMinimum": true,
                                "minimum": 0,
                                "type": "integer",
                              },
