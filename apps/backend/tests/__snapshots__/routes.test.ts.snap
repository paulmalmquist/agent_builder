    "/v1/repository-imports": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "improvementCandidateId": {
                    "description": "Optional incubating candidate whose proposed target exactly matches Kind:slug@version; the resulting lineage is set once and audited",
                    "format": "uuid",
                    "nullable": true,
                    "type": "string",
                  },
                  "manifestYaml": {
                    "maxLength": 1000000,
                    "minLength": 1,
                    "type": "string",
                  },
                  "sourcePath": {
                    "maxLength": 500,
                    "minLength": 1,
                    "nullable": true,
                    "type": "string",
                  },
                },
                "required": [
                  "manifestYaml",
                ],
                "type": "object",
              },
            },
          },
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "idempotent": {
                      "type": "boolean",
                    },
                    "import": {
                      "properties": {
                        "digest": {
                          "pattern": "^[a-f0-9]{64}$",
                          "type": "string",
                        },
                        "id": {
                          "format": "uuid",
                          "type": "string",
                        },
                        "importedAt": {
                          "format": "date-time",
                          "type": "string",
                        },
                        "importedBy": {
                          "type": "string",
                        },
                        "improvementCandidateId": {
                          "description": "Immutable reviewed improvement-candidate lineage, when supplied",
                          "format": "uuid",
                          "nullable": true,
                          "type": "string",
                        },
                        "resourceVersionId": {
                          "format": "uuid",
                          "type": "string",
                        },
                        "sourceCommit": {
                          "type": "string",
                        },
                        "sourcePath": {
                          "nullable": true,
                          "type": "string",
                        },
                      },
                      "required": [
                        "id",
                        "resourceVersionId",
                        "digest",
                        "sourceCommit",
                        "sourcePath",
                        "improvementCandidateId",
                        "importedBy",
                        "importedAt",
                      ],
                      "type": "object",
                    },
                    "resource": {
                      "properties": {
                        "createdAt": {
                          "format": "date-time",
                          "type": "string",
                        },
                        "definition": {
                          "properties": {
                            "apiVersion": {
                              "enum": [
                                "paul-os/v1",
                              ],
                              "type": "string",
                            },
                            "dependencies": {
                              "default": [],
                              "items": {
                                "properties": {
                                  "familyId": {
                                    "format": "uuid",
                                    "type": "string",
                                  },
                                  "version": {
                                    "maxLength": 80,
                                    "minLength": 1,
                                    "type": "string",
                                  },
                                },
                                "required": [
                                  "familyId",
                                  "version",
                                ],
                                "type": "object",
                              },
                              "maxItems": 100,
                              "type": "array",
                            },
                            "kind": {
                              "enum": [
                                "CorePolicy",
                                "ContextPolicy",
                                "Skill",
                                "Project",
                                "Automation",
                                "Reference",
                                "BusinessDomain",
                                "Protocol",
                                "KnowledgeSource",
                                "EvaluationSuite",
                                "MetricDefinition",
                                "ImprovementCandidate",
                                "Agent",
                              ],
                              "type": "string",
                            },
                            "metadata": {
                              "properties": {
                                "id": {
                                  "format": "uuid",
                                  "type": "string",
                                },
                                "lifecycle": {
                                  "enum": [
                                    "experimental",
                                    "candidate",
                                    "evaluating",
                                    "evaluated",
                                    "certified",
                                    "production",
                                    "deprecated",
                                  ],
                                  "type": "string",
                                },
                                "name": {
                                  "maxLength": 160,
                                  "minLength": 2,
                                  "type": "string",
                                },
                                "owner": {
                                  "maxLength": 200,
                                  "minLength": 2,
                                  "type": "string",
                                },
                                "provenance": {
                                  "anyOf": [
                                    {
                                      "maxLength": 500,
                                      "minLength": 1,
                                      "type": "string",
                                    },
                                    {
                                      "additionalProperties": true,
                                      "type": "object",
                                    },
                                  ],
                                },
                                "purpose": {
                                  "maxLength": 3000,
                                  "minLength": 10,
                                  "type": "string",
                                },
                                "slug": {
                                  "maxLength": 160,
                                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                                  "type": "string",
                                },
                                "version": {
                                  "maxLength": 80,
                                  "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
                                  "type": "string",
                                },
                              },
                              "required": [
                                "id",
                                "slug",
                                "version",
                                "owner",
                                "purpose",
                                "lifecycle",
                                "provenance",
                              ],
                              "type": "object",
                            },
                            "spec": {
                              "additionalProperties": true,
                              "type": "object",
                            },
                          },
                          "required": [
                            "apiVersion",
                            "kind",
                            "metadata",
                            "spec",
                          ],
                          "type": "object",
                        },
                        "dependencyPins": {
                          "items": {
                            "properties": {
                              "familyId": {
                                "format": "uuid",
                                "type": "string",
                              },
                              "version": {
                                "maxLength": 80,
                                "minLength": 1,
                                "type": "string",
                              },
                            },
                            "required": [
                              "familyId",
                              "version",
                            ],
                            "type": "object",
                          },
                          "type": "array",
                        },
                        "digest": {
                          "pattern": "^[a-f0-9]{64}$",
                          "type": "string",
                        },
                        "familyId": {
