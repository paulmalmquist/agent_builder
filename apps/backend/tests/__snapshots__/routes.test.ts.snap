    "/v1/builder/intakes/{intakeId}/referred-choices": {
      "get": {
        "operationId": "listReferredChoices",
        "parameters": [
          {
            "in": "path",
            "name": "intakeId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "compositionSuggestions": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "coveragePercent": {
                            "maximum": 100,
                            "minimum": 0,
                            "type": "number",
                          },
                          "delta": {
                            "additionalProperties": false,
                            "properties": {
                              "has": {
                                "items": {
                                  "maxLength": 320,
                                  "minLength": 1,
                                  "type": "string",
                                },
                                "maxItems": 500,
                                "type": "array",
                              },
                              "lacks": {
                                "items": {
                                  "maxLength": 320,
                                  "minLength": 1,
                                  "type": "string",
                                },
                                "maxItems": 500,
                                "type": "array",
                              },
                              "offers": {
                                "items": {
                                  "maxLength": 320,
                                  "minLength": 1,
                                  "type": "string",
                                },
                                "maxItems": 500,
                                "type": "array",
                              },
                            },
                            "required": [
                              "has",
                              "lacks",
                              "offers",
                            ],
                            "type": "object",
                          },
                          "key": {
                            "maxLength": 1000,
                            "minLength": 8,
                            "type": "string",
                          },
                          "skills": {
                            "items": {
                              "additionalProperties": false,
                              "properties": {
                                "name": {
                                  "maxLength": 160,
                                  "minLength": 2,
                                  "type": "string",
                                },
                                "publicationId": {
                                  "format": "uuid",
                                  "type": "string",
                                },
                                "resourceVersionId": {
                                  "format": "uuid",
                                  "type": "string",
                                },
                                "trustChip": {
                                  "additionalProperties": false,
                                  "properties": {
                                    "certificationState": {
                                      "enum": [
                                        "certified",
                                      ],
                                      "type": "string",
                                    },
                                    "corpusSize": {
                                      "exclusiveMinimum": true,
                                      "minimum": 0,
                                      "type": "integer",
                                    },
                                    "gatesPassed": {
                                      "exclusiveMinimum": true,
                                      "minimum": 0,
                                      "type": "integer",
                                    },
                                    "gatesTotal": {
                                      "exclusiveMinimum": true,
                                      "minimum": 0,
                                      "type": "integer",
                                    },
                                    "label": {
                                      "maxLength": 180,
                                      "minLength": 10,
                                      "type": "string",
                                    },
                                    "recertifiedAt": {
                                      "format": "date-time",
                                      "type": "string",
                                    },
                                  },
                                  "required": [
                                    "certificationState",
                                    "gatesPassed",
                                    "gatesTotal",
                                    "corpusSize",
                                    "recertifiedAt",
                                    "label",
                                  ],
                                  "type": "object",
                                },
                                "version": {
                                  "maxLength": 80,
                                  "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
                                  "type": "string",
                                },
                              },
                              "required": [
                                "publicationId",
                                "resourceVersionId",
                                "name",
                                "version",
                                "trustChip",
                              ],
                              "type": "object",
                            },
                            "maxItems": 5,
                            "minItems": 2,
                            "type": "array",
                          },
                        },
                        "required": [
                          "key",
                          "skills",
                          "coveragePercent",
                          "delta",
                        ],
                        "type": "object",
                      },
                      "maxItems": 5,
                      "type": "array",
                    },
                    "generatedAt": {
                      "format": "date-time",
                      "type": "string",
                    },
                    "intakeId": {
                      "format": "uuid",
                      "type": "string",
                    },
                    "referredChoices": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "cost": {
                            "additionalProperties": false,
                            "properties": {
                              "basis": {
                                "enum": [
                                  "observed",
                                  "estimated",
                                  "unavailable",
                                ],
                                "type": "string",
                              },
                              "usdPerRun": {
                                "minimum": 0,
                                "nullable": true,
                                "type": "number",
                              },
                            },
                            "required": [
                              "usdPerRun",
                              "basis",
                            ],
                            "type": "object",
                          },
                          "delta": {
                            "additionalProperties": false,
                            "properties": {
                              "has": {
                                "items": {
                                  "maxLength": 320,
                                  "minLength": 1,
                                  "type": "string",
                                },
                                "maxItems": 500,
                                "type": "array",
                              },
                              "lacks": {
                                "items": {
                                  "maxLength": 320,
                                  "minLength": 1,
                                  "type": "string",
                                },
                                "maxItems": 500,
                                "type": "array",
                              },
                              "offers": {
                                "items": {
                                  "maxLength": 320,
                                  "minLength": 1,
                                  "type": "string",
                                },
                                "maxItems": 500,
                                "type": "array",
                              },
                            },
                            "required": [
                              "has",
                              "lacks",
                              "offers",
                            ],
                            "type": "object",
                          },
                          "deployment": {
                            "additionalProperties": false,
                            "properties": {
                              "active": {
                                "minimum": 0,
                                "type": "integer",
                              },
                              "total": {
                                "minimum": 0,
                                "type": "integer",
                              },
                            },
                            "required": [
                              "total",
                              "active",
                            ],
                            "type": "object",
                          },
                          "knownLimitations": {
                            "items": {
                              "maxLength": 500,
                              "minLength": 1,
                              "type": "string",
                            },
                            "maxItems": 30,
                            "type": "array",
                          },
                          "match": {
                            "additionalProperties": false,
                            "properties": {
                              "embeddingCosine": {
                                "maximum": 1,
                                "minimum": 0,
                                "nullable": true,
                                "type": "number",
                              },
                              "label": {
                                "enum": [
                                  "70% capability coverage + 30% embedding cosine",
                                  "Structured-only fallback",
                                ],
                                "type": "string",
                              },
                              "mode": {
                                "enum": [
                                  "hybrid_70_30",
                                  "structured_only_fallback",
                                ],
                                "type": "string",
                              },
                              "score": {
                                "maximum": 100,
                                "minimum": 0,
                                "type": "number",
                              },
                              "structuredCoverage": {
                                "maximum": 100,
                                "minimum": 0,
                                "type": "number",
                              },
                            },
                            "required": [
                              "score",
                              "structuredCoverage",
                              "embeddingCosine",
                              "mode",
                              "label",
                            ],
                            "type": "object",
                          },
                          "name": {
                            "maxLength": 160,
                            "minLength": 2,
                            "type": "string",
                          },
                          "provenance": {
                            "additionalProperties": false,
                            "properties": {
                              "department": {
                                "maxLength": 160,
                                "minLength": 2,
                                "type": "string",
                              },
                              "owner": {
                                "maxLength": 200,
                                "minLength": 2,
                                "type": "string",
                              },
                              "publishedAt": {
                                "format": "date-time",
                                "type": "string",
                              },
                              "releaseDigest": {
                                "pattern": "^[a-f0-9]{64}$",
                                "type": "string",
                              },
                              "releaseId": {
                                "format": "uuid",
                                "type": "string",
                              },
                              "resourceVersionId": {
                                "format": "uuid",
                                "type": "string",
                              },
                            },
                            "required": [
                              "owner",
                              "department",
                              "resourceVersionId",
                              "releaseId",
                              "releaseDigest",
                              "publishedAt",
                            ],
                            "type": "object",
                          },
                          "publicationId": {
                            "format": "uuid",
                            "type": "string",
                          },
                          "subjectKind": {
                            "enum": [
                              "agent",
                            ],
                            "type": "string",
                          },
                          "success": {
                            "additionalProperties": false,
                            "properties": {
                              "measuredRuns": {
                                "minimum": 0,
                                "type": "integer",
                              },
                              "rate": {
                                "maximum": 1,
                                "minimum": 0,
                                "nullable": true,
                                "type": "number",
                              },
                              "successfulRuns": {
                                "minimum": 0,
                                "type": "integer",
                              },
                            },
                            "required": [
