    "/v1/authority-grants": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "enum": [
                "active",
                "revoked",
                "exhausted",
                "expired",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "items": {
                      "items": {
                        "properties": {
                          "actorId": {
                            "type": "string",
                          },
                          "contextDigest": {
                            "pattern": "^[a-f0-9]{64}$",
                            "type": "string",
                          },
                          "createdAt": {
                            "format": "date-time",
                            "type": "string",
                          },
                          "id": {
                            "format": "uuid",
                            "type": "string",
                          },
                          "inputConstraints": {
                            "additionalProperties": true,
                            "type": "object",
                          },
                          "maxEstimatedCostPerRunUsd": {
                            "minimum": 0,
                            "type": "number",
                          },
                          "maxRuns": {
                            "exclusiveMinimum": true,
                            "minimum": 0,
                            "type": "integer",
                          },
                          "projectId": {
                            "nullable": true,
                            "type": "string",
                          },
                          "rationale": {
                            "type": "string",
                          },
                          "releaseDigest": {
                            "pattern": "^[a-f0-9]{64}$",
                            "type": "string",
                          },
                          "releaseId": {
                            "format": "uuid",
                            "type": "string",
                          },
                          "reservedCostUsd": {
                            "minimum": 0,
                            "type": "number",
                          },
                          "revokedAt": {
                            "format": "date-time",
                            "nullable": true,
                            "type": "string",
                          },
                          "spentCostUsd": {
                            "minimum": 0,
                            "type": "number",
                          },
                          "state": {
                            "enum": [
                              "active",
                              "revoked",
                              "exhausted",
                              "expired",
                            ],
                            "type": "string",
                          },
                          "toolScopes": {
                            "items": {
                              "type": "string",
                            },
                            "type": "array",
                          },
                          "totalCostBudgetUsd": {
                            "minimum": 0,
                            "type": "number",
                          },
                          "usedRuns": {
                            "minimum": 0,
                            "type": "integer",
                          },
                          "validFrom": {
                            "format": "date-time",
                            "type": "string",
                          },
                          "validUntil": {
                            "format": "date-time",
                            "type": "string",
                          },
                        },
                        "required": [
                          "id",
                          "releaseId",
                          "releaseDigest",
                          "contextDigest",
                          "projectId",
                          "inputConstraints",
                          "toolScopes",
                          "validFrom",
                          "validUntil",
                          "maxRuns",
                          "usedRuns",
                          "maxEstimatedCostPerRunUsd",
                          "totalCostBudgetUsd",
                          "spentCostUsd",
                          "reservedCostUsd",
                          "state",
                          "actorId",
                          "rationale",
                          "revokedAt",
                          "createdAt",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                  },
                  "required": [
                    "items",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Authority grants",
          },
        },
      },
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "contextDigest": {
                    "pattern": "^[a-f0-9]{64}$",
                    "type": "string",
                  },
                  "inputConstraints": {
                    "additionalProperties": true,
                    "type": "object",
                  },
                  "maxEstimatedCostPerRunUsd": {
                    "maximum": 100000,
                    "minimum": 0,
                    "type": "number",
                  },
                  "maxRuns": {
                    "maximum": 1000000,
                    "minimum": 1,
                    "type": "integer",
                  },
                  "projectId": {
                    "maxLength": 160,
                    "minLength": 1,
                    "nullable": true,
                    "type": "string",
                  },
                  "rationale": {
                    "maxLength": 2000,
                    "minLength": 10,
                    "type": "string",
                  },
                  "releaseId": {
                    "format": "uuid",
                    "type": "string",
                  },
                  "toolScopes": {
                    "default": [],
                    "items": {
                      "maxLength": 160,
                      "minLength": 1,
                      "type": "string",
                    },
                    "maxItems": 100,
                    "type": "array",
                  },
                  "totalCostBudgetUsd": {
                    "maximum": 1000000,
                    "minimum": 0,
                    "type": "number",
                  },
                  "validUntil": {
                    "format": "date-time",
                    "type": "string",
                  },
                },
                "required": [
