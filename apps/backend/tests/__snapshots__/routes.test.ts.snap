                      "type": "number",
                    },
                    "maxInputTokens": {
                      "exclusiveMinimum": true,
                      "minimum": 0,
                      "type": "integer",
                    },
                    "maxOutputTokens": {
                      "exclusiveMinimum": true,
                      "minimum": 0,
                      "type": "integer",
                    },
