                          "secretSlots",
                          "activeScopeDescriptions",
                          "costThisWeekUsd",
                          "installationId",
                          "installationState",
                          "healthStatus",
                          "lastUsedAt",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                  },
                  "required": [
                    "items",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Sanitized Plugin catalog",
