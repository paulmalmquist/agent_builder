                      "type": "string",
                    },
                    "model": {
                      "type": "string",
                    },
                    "pricingVersion": {
                      "type": "string",
                    },
                    "progress": {
                      "maximum": 100,
                      "minimum": 0,
                      "type": "integer",
                    },
                    "projectId": {
                      "nullable": true,
                      "type": "string",
                    },
                    "providerKind": {
                      "enum": [
