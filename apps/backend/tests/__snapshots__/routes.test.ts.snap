    "/v1/production-channels/{channelKey}/decline": {
      "post": {
        "parameters": [
          {
            "in": "path",
            "name": "channelKey",
            "required": true,
            "schema": {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[a-z0-9]+(?:[-_.][a-z0-9]+)*$",
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "evaluationId": {
                    "format": "uuid",
                    "type": "string",
                  },
                  "rationale": {
                    "maxLength": 2000,
                    "minLength": 10,
                    "type": "string",
                  },
                  "releaseId": {
                    "format": "uuid",
                    "type": "string",
                  },
                },
                "required": [
                  "releaseId",
                  "evaluationId",
                  "rationale",
                ],
                "type": "object",
              },
            },
          },
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "channel": {
                      "nullable": true,
                      "properties": {
                        "currentReleaseDigest": {
                          "nullable": true,
                          "pattern": "^[a-f0-9]{64}$",
                          "type": "string",
                        },
                        "currentReleaseId": {
                          "format": "uuid",
                          "nullable": true,
                          "type": "string",
                        },
                        "key": {
                          "maxLength": 160,
                          "minLength": 1,
                          "pattern": "^[a-z0-9]+(?:[-_.][a-z0-9]+)*$",
                          "type": "string",
                        },
                        "priorReleaseId": {
                          "format": "uuid",
                          "nullable": true,
                          "type": "string",
                        },
                        "projectId": {
                          "nullable": true,
                          "type": "string",
                        },
                        "promotedAt": {
                          "format": "date-time",
                          "nullable": true,
                          "type": "string",
                        },
                        "promotedBy": {
                          "nullable": true,
                          "type": "string",
                        },
                        "updatedAt": {
                          "format": "date-time",
                          "type": "string",
                        },
                      },
                      "required": [
                        "key",
                        "projectId",
                        "currentReleaseId",
                        "currentReleaseDigest",
                        "priorReleaseId",
                        "promotedBy",
                        "promotedAt",
                        "updatedAt",
                      ],
                      "type": "object",
                    },
                    "decision": {
                      "properties": {
                        "action": {
                          "enum": [
                            "declined",
                          ],
                          "type": "string",
                        },
                        "channelKey": {
                          "maxLength": 160,
                          "minLength": 1,
                          "pattern": "^[a-z0-9]+(?:[-_.][a-z0-9]+)*$",
                          "type": "string",
                        },
                        "decidedAt": {
                          "format": "date-time",
                          "type": "string",
                        },
                        "decidedBy": {
                          "type": "string",
                        },
                        "evaluationId": {
                          "format": "uuid",
                          "type": "string",
                        },
                        "id": {
                          "format": "uuid",
                          "type": "string",
                        },
                        "rationale": {
                          "type": "string",
                        },
                        "releaseId": {
                          "format": "uuid",
                          "type": "string",
                        },
                      },
                      "required": [
                        "id",
                        "channelKey",
                        "action",
                        "releaseId",
                        "evaluationId",
                        "rationale",
                        "decidedBy",
                        "decidedAt",
