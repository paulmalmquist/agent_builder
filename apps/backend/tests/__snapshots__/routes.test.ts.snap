                                  "type": "boolean",
                                },
                              },
                              "required": [
                                "name",
                                "description",
                                "required",
                              ],
                              "type": "object",
                            },
                            "type": "array",
                          },
                          "slug": {
                            "type": "string",
                          },
                          "transport": {
                            "enum": [
                              "mcp",
                              "http",
                              "cli",
                              "db",
                            ],
                            "type": "string",
                          },
                          "version": {
                            "maxLength": 80,
                            "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
                            "type": "string",
                          },
                        },
                        "required": [
