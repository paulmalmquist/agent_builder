{
  "name": "@agent-builder/backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "prisma generate --schema prisma/schema.prisma && tsc -b",
    "typecheck": "prisma generate --schema prisma/schema.prisma && tsc -b --pretty false",
    "clean": "tsc -b --clean",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "jest --config jest.config.cjs",
    "test:oidc-jwks": "npm run build && node tests/oidc-jwks.smoke.mjs",
    "test:coverage": "jest --config jest.config.cjs --coverage",
    "certify:console-copy": "node dist/console-copy-certify.js",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate --schema prisma/schema.prisma"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@agent-builder/contracts": "0.2.0",
    "@google-cloud/bigquery": "9.0.2",
    "@paul-os/runtime": "0.1.0",
    "@prisma/client": "7.9.1",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "jose": "6.2.9",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "playwright-core": "1.62.1",
    "prisma": "7.9.1",
    "saxes": "6.0.0",
    "tsx": "4.23.12",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/supertest": "6.0.2",
    "jest": "29.7.0",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "typescript": "5.8.3"
  }
}
