{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "deploymentMode",
    "global",
    "images",
    "externalSecrets",
    "auth",
    "backend",
    "worker",
    "frontend",
    "serviceAccounts",
    "networkPolicy",
    "podSecurityContext",
    "containerSecurityContext",
    "nodeContainerSecurityContext",
    "kindDemo",
    "postgres"
  ],
  "properties": {
    "deploymentMode": { "enum": ["proposal", "kind", "production"] },
    "global": { "type": "object" },
    "images": { "type": "object" },
    "externalSecrets": { "type": "object" },
    "auth": { "type": "object" },
    "backend": {
      "type": "object",
      "properties": { "replicaCount": { "const": 1 } },
      "required": ["replicaCount"]
    },
    "worker": { "type": "object" },
    "frontend": { "type": "object" },
    "serviceAccounts": { "type": "object" },
    "networkPolicy": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "containerSecurityContext": { "type": "object" },
    "nodeContainerSecurityContext": { "type": "object" },
    "kindDemo": { "type": "object" },
    "postgres": { "type": "object" }
  }
}
