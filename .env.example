NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://agent_builder:agent_builder@localhost:5432/agent_builder?schema=public&connection_limit=10&pool_timeout=10
# Proposal-ready role split. These remain opt-in until every legacy repository is RLS-scoped.
DATABASE_MIGRATOR_URL=
DATABASE_API_URL=
DATABASE_WORKER_URL=
VITE_API_BASE_URL=
VITE_AIM_ENABLED=true

# Agent generation remains deterministic. Paul OS model execution also defaults to a deterministic provider.
GENERATOR_CLI_PATH=apps/generator-cli/dist/index.js
GENERATOR_TIMEOUT_MS=60000
GENERATOR_CONCURRENCY=2
GENERATOR_MAX_OUTPUT_BYTES=1048576
SHUTDOWN_TIMEOUT_MS=15000
SEED_ON_BOOT=false

# Certification uses the deterministic manifest-fixture executor in this scaffold.
CERTIFICATION_CONCURRENCY=2
CERTIFICATION_RUN_TIMEOUT_MS=120000
CERTIFICATION_EXECUTOR_VERSION=1.0.0
CERTIFICATION_FULL_RUN_RETENTION=20
INTERPRETATION_TTL_HOURS=24
MAINTENANCE_ENABLED=true
MAINTENANCE_HOUR_UTC=2
# Autonomous schedule polling is database-locked and idempotent. Disable it when an external
# scheduler invokes POST /v1/automation-schedules/schedule-due.
AUTOMATION_SCHEDULER_ENABLED=true
AUTOMATION_SCHEDULER_INTERVAL_MS=30000
AUTOMATION_SCHEDULER_BATCH_SIZE=25

# Direct model execution is opt-in. Never commit keys or prompts.
MODEL_PROVIDER=deterministic
PROVIDER_POLICY=direct_allowed
MODEL_NAME=daily-brief-fixture
ANTHROPIC_API_KEY=
MODEL_TIMEOUT_MS=120000
MODEL_INPUT_USD_PER_MILLION_TOKENS=3
MODEL_OUTPUT_USD_PER_MILLION_TOKENS=15
MODEL_PRICING_VERSION=local-2026-08
# Local-only opt-in. Set false and supply an immutable Git commit before promotion/deployment.
ALLOW_UNVERIFIED_REPOSITORY_IMPORTS=true
REPOSITORY_SOURCE_COMMIT=
EXECUTION_CONCURRENCY=2
EXECUTION_LEASE_MS=60000
EXECUTION_DISPATCH_MODE=in_process

# Durable worker settings. Set EXECUTION_DISPATCH_MODE=external when this process is running.
WORKER_ID=local-worker
WORKER_CONCURRENCY=2
WORKER_POLL_MS=1000
WORKER_LEASE_MS=60000
WORKER_HEARTBEAT_MS=15000
WORKER_SHUTDOWN_TIMEOUT_MS=20000
PAUL_OS_PROFILE_PATH=.local/profile/profile.yaml
PAUL_OS_BACKUP_PASSPHRASE=

# Local and static bearer remain compatible. fixture_oidc is test/development only; oidc fails
# closed until an approved verifier is installed. Never put identity tokens in this file.
AUTH_MODE=local
AUTH_BEARER_TOKEN=
AUTH_ACTOR_ID=local-user
AUTH_PRINCIPAL_ID=
AUTH_WORKSPACE_ID=
AUTH_DEPARTMENT_ID=
AUTH_ROLES=admin
FIXTURE_OIDC_SECRET=
OIDC_ISSUER=
OIDC_AUDIENCES=
OIDC_JWKS_URI=
OIDC_GROUP_CLAIM=groups
# fail_closed is the safe default. jwks enables the standards-compatible remote-JWKS verifier.
OIDC_VERIFIER=fail_closed

# BigQuery is opt-in and read-only. Local tests use fixture connectors.
BIGQUERY_ENABLED=false
# Required when BIGQUERY_ENABLED=true. There is intentionally no project default.
GOOGLE_CLOUD_PROJECT=
BIGQUERY_MAXIMUM_BYTES_BILLED=10000000

# Future live providers fail closed until their connector and credential configuration exist.
CONFLUENCE_ENABLED=false
JIRA_ENABLED=false
EMAIL_ENABLED=false
SLACK_ENABLED=false
TELEMETRY_ENABLED=false
