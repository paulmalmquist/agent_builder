{
  "name": "@agent-builder/contracts",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./openapi": {
      "types": "./dist/openapi.d.ts",
      "import": "./dist/openapi.js"
    },
    "./aim": {
      "types": "./dist/aim/index.d.ts",
      "import": "./dist/aim/index.js"
    },
    "./aim/schema": {
      "types": "./dist/aim/schema.d.ts",
      "import": "./dist/aim/schema.js"
    },
    "./workstation-broker": {
      "types": "./dist/workstation-broker-domain.d.ts",
      "import": "./dist/workstation-broker-domain.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "node --test test/*.test.mjs",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "7.3.0",
    "zod": "3.24.2"
  }
}
